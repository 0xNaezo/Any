---
import CasePage from '@/components/CasePage.astro';
import { getDictionary } from '@/i18n';

export function getStaticPaths() {
  return getDictionary('en').work.items.map((item) => ({ params: { slug: item.slug } }));
}

const dict = getDictionary('en');
const item = dict.work.items.find((c) => c.slug === Astro.params.slug)!;
---

<CasePage dict={dict} item={item} />
