---
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import Frame from '@/components/ui/Frame.astro';
import PixelIcon from '@/components/ui/PixelIcon.astro';
import WorkImage from '@/components/ui/WorkImage.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site, type CaseStudy } from '@/data/site';

export const getStaticPaths = (() => {
  const cases = site.work.cases;
  return cases.map((c, i) => ({
    params: { slug: c.slug },
    props: { c, index: i, next: cases[(i + 1) % cases.length] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  c: CaseStudy;
  index: number;
  next: CaseStudy;
}

const { c, index, next } = Astro.props;
const no = String(index + 1).padStart(2, '0');
const facts = [
  { k: 'Industry', v: c.industry },
  { k: 'Year', v: String(c.year) },
  { k: 'Duration', v: c.duration },
  { k: 'Team', v: c.team },
  { k: 'Services', v: c.services.join(' · ') },
  { k: 'Stack', v: c.stack.join(' · ') },
];
---

<Base title={`${c.name} — case study`} description={c.summary}>
  <section class="container cs-hero" aria-labelledby="cs-title">
    <Frame as="div" label={`Case ${no} / ${c.name}`} meta={`${c.industry} · ${c.year}`}>
      <a class="cs-back px" href="/#work">
        <PixelIcon name="arrow-left" />
        All work
      </a>
      <h1 id="cs-title" class="h-hero cs-title" data-reveal="wipe">{c.name}</h1>
      <p class="cs-sub" data-reveal>{c.title}</p>
      <p class="lead cs-summary" data-reveal>{c.summary}</p>
      <dl class="cs-facts" data-reveal-stagger>
        {
          facts.map((f) => (
            <div data-reveal-item>
              <dt class="px">{f.k}</dt>
              <dd class="small">{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </Frame>
  </section>

  <div class="container section cs-media-wrap">
    <div class="cs-media wimg-host">
      <WorkImage image={c.cover} alt={c.coverAlt} label={c.name} eager sizes="(min-width: 1344px) 1280px, 100vw" />
    </div>
  </div>

  <div class="container section">
    <Frame label="01 / The challenge" meta="Before">
      <div class="cs-split">
        <h2 class="h-section" data-reveal="wipe">The problem</h2>
        <p class="lead cs-text" data-reveal>{c.challenge}</p>
      </div>
    </Frame>
  </div>

  <div class="container section">
    <Frame label="02 / What we did" meta={`${c.approach.length} moves`}>
      <ol class="cs-steps" data-reveal-stagger>
        {
          c.approach.map((a, i) => (
            <li class="cs-step" data-reveal-item>
              <span class="cs-step__no px">{String(i + 1).padStart(2, '0')}</span>
              <p>{a}</p>
            </li>
          ))
        }
      </ol>
    </Frame>
  </div>

  {
    c.detail && (
      <div class="container section">
        <div class="cs-media wimg-host">
          <WorkImage image={c.detail} alt={c.detailAlt} label={c.name} sizes="(min-width: 1344px) 1280px, 100vw" />
        </div>
      </div>
    )
  }

  <div class="container section">
    <Frame label="03 / Results" meta="After">
      <dl class="cs-metrics" data-reveal-stagger>
        {
          c.metrics.map((m) => (
            <div data-reveal-item>
              <dt class="small">{m.label}</dt>
              <dd class="px tnum">{m.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="lead cs-outcome" data-reveal>{c.outcome}</p>
      {
        c.quote && (
          <figure class="cs-quote" data-reveal>
            <PixelIcon name="quote" size={36} />
            <blockquote>
              <p>{c.quote.text}</p>
            </blockquote>
            <figcaption class="small">
              <strong>{c.quote.author}</strong> · {c.quote.role}
            </figcaption>
          </figure>
        )
      }
    </Frame>
  </div>

  <div class="container section">
    <a class="cs-next frame dash corners wimg-host" href={`/work/${next.slug}/`} data-frame>
      <span class="cs-next__text">
        <span class="label">Next case</span>
        <span class="cs-next__name">{next.name}</span>
        <span class="small muted">{next.title}</span>
      </span>
      <span class="cs-next__media">
        <WorkImage image={next.cover} alt="" label={next.name} sizes="360px" />
      </span>
      <span class="cs-next__go" aria-hidden="true">
        <PixelIcon name="arrow-right" size={32} />
      </span>
    </a>
  </div>

  <CtaBand />
</Base>

<style>
  .cs-hero {
    padding-top: calc(var(--nav-h) + 40px);
  }
  .cs-back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    margin-bottom: 32px;
  }
  .cs-back:hover {
    color: var(--accent-hi);
  }
  .cs-title {
    max-width: 16ch;
  }
  .cs-sub {
    margin-top: 24px;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--ink);
    max-width: 40ch;
  }
  .cs-summary {
    margin-top: 16px;
    color: var(--ink-2);
  }
  .cs-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 48px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @media (max-width: 379px) {
    .cs-facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (min-width: 960px) {
    .cs-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cs-facts > div {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 18px 20px;
    box-shadow:
      inset -1px 0 0 0 var(--line),
      inset 0 -1px 0 0 var(--line);
  }
  .cs-facts dt {
    font-size: 16px;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .cs-facts dd {
    color: var(--ink);
  }

  .cs-media-wrap {
    margin-top: 32px;
  }
  .cs-media {
    box-shadow:
      0 0 0 1px var(--line-2),
      12px 12px 0 0 var(--tint-2);
  }

  .cs-split {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 960px) {
    .cs-split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 64px;
    }
  }
  .cs-text {
    color: var(--ink);
    font-size: 18px;
  }

  .cs-steps {
    display: grid;
  }
  @media (min-width: 900px) {
    .cs-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 48px;
    }
  }
  .cs-step {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding: 24px 0;
    background: repeating-linear-gradient(90deg, var(--line) 0 4px, transparent 4px 8px) top / 100% 1px no-repeat;
  }
  .cs-step__no {
    font-size: 24px;
    color: var(--accent);
  }
  .cs-step p {
    color: var(--ink-2);
  }

  .cs-metrics {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 800px) {
    .cs-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cs-metrics > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 12px;
    padding: 24px;
    box-shadow: inset 0 0 0 1px var(--line);
    background: var(--tint);
  }
  .cs-metrics dd {
    font-size: 48px;
    color: var(--accent);
    white-space: nowrap;
  }
  @media (min-width: 1200px) {
    .cs-metrics dd {
      font-size: 64px;
    }
  }
  .cs-metrics dt {
    color: var(--ink-2);
  }
  .cs-outcome {
    margin-top: 40px;
    font-size: 18px;
  }
  .cs-quote {
    display: grid;
    gap: 20px;
    margin-top: 48px;
    padding-top: 40px;
    color: var(--accent-mid);
    background: repeating-linear-gradient(90deg, var(--line) 0 4px, transparent 4px 8px) top / 100% 1px no-repeat;
  }
  .cs-quote blockquote {
    font-size: 21px;
    line-height: 1.6;
    color: var(--ink);
    max-width: 60ch;
  }
  .cs-quote figcaption {
    color: var(--ink-2);
  }
  .cs-quote strong {
    color: var(--ink);
  }

  .cs-next {
    display: grid;
    gap: 24px;
    padding: var(--frame-pad);
    align-items: center;
    transition: background-color var(--t-med) steps(3);
  }
  .cs-next:hover {
    background: var(--bg-1);
  }
  @media (min-width: 800px) {
    .cs-next {
      grid-template-columns: minmax(0, 1fr) 320px auto;
      gap: 40px;
    }
  }
  .cs-next__text {
    display: grid;
    gap: 12px;
  }
  .cs-next__text .label {
    color: var(--ink-3);
  }
  .cs-next__name {
    font-family: var(--font-pixel);
    font-size: var(--fs-h2);
    line-height: 1;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cs-next__media {
    display: block;
    box-shadow: 0 0 0 1px var(--line-2);
  }
  .cs-next__go {
    color: var(--accent);
    transition: transform var(--t-fast) steps(2);
  }
  .cs-next:hover .cs-next__go {
    transform: translateX(6px);
  }
</style>
