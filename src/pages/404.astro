---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { plain, rich, withBase } from '../lib/utils';

const { notFound } = site;
---

<Base title={`Page not found — ${site.name}`} description={plain(notFound.text)} noindex>
  <section class="nf" aria-labelledby="nf-title">
    <canvas class="nf__canvas" data-threads aria-hidden="true"></canvas>
    <div class="nf__ghost" data-ghost-anchor aria-hidden="true"></div>

    <div class="container nf__inner">
      <p class="label nf__code" data-hero-item>Error 404 — page not found</p>
      <div class="nf__body">
        <h1 id="nf-title" class="nf__title" data-hero-title set:html={rich(notFound.title)} />
        <p class="lead nf__text" data-hero-item>{notFound.text}</p>
        <div class="nf__actions" data-hero-item>
          <Button label={notFound.cta} href={withBase('/')} icon="arrow-right" />
          <Button label="Start a project" href={`${withBase('/')}#contact`} variant="ghost" icon={null} />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    min-height: 100svh;
    display: flex;
    overflow: hidden;
    isolation: isolate;
  }
  .nf__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .nf::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, var(--bg) 0%, transparent 20%, transparent 50%, rgb(10 10 12 / 0.9) 76%, var(--bg) 100%);
  }
  .nf__ghost {
    position: absolute;
    z-index: -2;
    visibility: hidden;
    left: 50%;
    top: calc(var(--header-h) + 6vh);
    width: clamp(180px, 22vw, 320px);
    aspect-ratio: 20 / 24;
    transform: translateX(-50%);
  }
  .nf__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(var(--header-h) + 32px);
    padding-bottom: clamp(48px, 8vh, 96px);
  }
  .nf__code {
    color: var(--fg-2);
  }
  .nf__body {
    display: grid;
    gap: 24px;
    max-width: 760px;
  }
  .nf__title {
    font-size: clamp(2.75rem, 1.2rem + 5vw, 6rem);
    font-weight: 450;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .nf__text {
    max-width: 44ch;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
