---
import '@/styles/global.css';
import tiny5Url from '@fontsource/tiny5/files/tiny5-latin-400-normal.woff2?url';
import plexUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import { site } from '@/data/site';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Backdrop from '@/components/Backdrop.astro';
import Preloader from '@/components/Preloader.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path to the social preview image, relative to the site root. */
  image?: string;
  noindex?: boolean;
  /** Show the boot sequence (home page only). */
  preloader?: boolean;
}

const { title, description = site.seo.description, image = '/og.png', noindex = false, preloader = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.brand.name}` : site.seo.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.brand.name,
  legalName: site.brand.legalName,
  url: Astro.site?.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
  image: ogImage.toString(),
  email: site.brand.email,
  description: site.seo.description,
  foundingDate: String(site.brand.founded),
  address: { '@type': 'PostalAddress', addressLocality: 'Prague', addressCountry: 'CZ' },
  areaServed: 'Worldwide',
  knowsAbout: site.services.items.map((s) => s.title),
  sameAs: [site.brand.github, site.brand.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#05070d" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={tiny5Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Progressive enhancement flags. Content stays visible if JS fails. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var booted = false;
        try { booted = sessionStorage.getItem('nl-booted') === '1'; } catch (e) {}
        d.classList.add('js');
        if (reduced) d.classList.add('reduced');
        d.classList.add(booted || reduced ? 'no-boot' : 'booting');
        window.setTimeout(function () {
          if (!window.__nightloomReady) d.classList.add('reveal-fallback');
        }, 3500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {preloader && <Preloader />}
    <Backdrop />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
