---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/onest/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';

import displayLatin from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import displayCyr from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-cyrillic-wght-normal.woff2?url';
import textLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import textCyr from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';

import { site } from '../site.config';
import { defaultLocale, getContent, localePath, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Page slug without slashes, '' for the landing page. */
  page?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Extra JSON-LD blocks. */
  schema?: Record<string, unknown>[];
}

const { locale, page = '', title, description, noindex = false, schema = [] } = Astro.props;
const t = getContent(locale);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(localePath(locale, page), site.url).href;
const ogImage = new URL(locale === defaultLocale ? '/og.jpg' : `/og-${locale}.jpg`, site.url).href;
const preload = locale === 'ru' ? [displayCyr, textCyr] : [displayLatin, textLatin];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  image: ogImage,
  description: pageDescription,
  email: site.email,
  foundingDate: String(site.founded),
  areaServed: 'Worldwide',
  knowsAbout: ['Software development', 'Web applications', 'Mobile applications', 'Product design', 'DevOps'],
  sameAs: site.socials.map((s) => s.href),
};

// On the default-locale landing page: send visitors whose saved (or browser) language is
// another supported locale to their version. Choosing a language in the switcher saves it.
const redirectScript =
  page === '' && locale === defaultLocale
    ? `(function(){try{var s=localStorage.getItem('nl-locale');var l=s||((navigator.languages&&navigator.languages[0])||navigator.language||'').slice(0,2).toLowerCase();var ok=${JSON.stringify(locales.filter((l) => l !== defaultLocale))};if(ok.indexOf(l)>-1){location.replace('/'+l+'/'+location.hash);}}catch(e){}})();`
    : '';
---

<!doctype html>
<html lang={t.htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {locales.map((l) => (
            <link rel="alternate" hreflang={getContent(l).htmlLang} href={new URL(localePath(l, page), site.url).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale, page), site.url).href} />
        </>
      )
    }

    <meta name="theme-color" content="#08090c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <script is:inline set:html={`document.documentElement.classList.replace('no-js','js');${redirectScript}`} />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
