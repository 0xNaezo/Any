---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { studio } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Hide the global header CTA/nav (used on the 404 page). */
  minimal?: boolean;
}

const {
  title,
  description = studio.description,
  image = '/og.png',
  noindex = false,
  minimal = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${studio.name}` : `${studio.name} — ${studio.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? studio.url).href;
const ogImage = new URL(image, Astro.site ?? studio.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: studio.name,
  legalName: studio.legalName,
  url: studio.url,
  logo: new URL('/icon-512.png', Astro.site ?? studio.url).href,
  image: ogImage,
  email: studio.email,
  foundingDate: String(studio.founded),
  description: studio.description,
  areaServed: 'Worldwide',
  sameAs: studio.social.map((s) => s.url),
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-plex-mono" preload={[{ weight: '500' }]} />

    <script is:inline>
      // Progressive enhancement: hidden-until-animated states only apply when JS runs
      // and the visitor hasn't asked for reduced motion. A watchdog reveals everything
      // if the animation bundle fails to start.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          window.setTimeout(function () {
            if (!d.classList.contains('motion-ready')) d.classList.remove('motion');
          }, 3500);
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body data-email={studio.email}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="warp" aria-hidden="true">
      <div class="container"><div class="warp-cols"><span></span><span></span><span></span><span></span></div></div>
    </div>

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer minimal={minimal} />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
