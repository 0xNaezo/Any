---
import SectionHead from './SectionHead.astro';
import Weave from './Weave.astro';
import Icon from './Icon.astro';
import type { Content } from '../i18n';

interface Props {
  t: Content;
  index: string;
}
const { t, index } = Astro.props;
const team = t.team;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2);
---

<section class="section team" id="studio" aria-labelledby="studio-title">
  <div class="container">
    <SectionHead index={index} label={team.label} title={team.title} intro={team.intro} id="studio-title" />

    <ul class="members">
      {
        team.members.map((m, i) => (
          <li class="member" data-reveal>
            <div class="member__portrait ticks">
              {m.photo ? (
                <img src={m.photo} alt={m.name} loading="lazy" decoding="async" />
              ) : (
                <Weave weave={m.weave} initials={initials(m.name)} id={`weave-${t.locale}-${i}`} />
              )}
              {!m.photo && (
                <span class="member__weave label" aria-hidden="true">
                  {team.weaves[m.weave]}
                </span>
              )}
            </div>
            <div class="member__info">
              <div class="member__row">
                <h3 class="member__name">{m.name}</h3>
                <span class="member__years" title={`${m.years} ${team.experience}`}>
                  {m.years}
                  <span class="visually-hidden"> {team.experience}</span>
                </span>
              </div>
              <p class="label member__role">{m.role}</p>
              <p class="member__bio">{m.bio}</p>
              <ul class="member__links">
                {m.links.map((l) => (
                  <li>
                    <a class="link" href={l.href} target="_blank" rel="noopener">
                      {l.label}
                      <Icon name="arrow-up-right" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="team__note" data-reveal>
      <span class="label label--bright">+</span>
      {team.note}
    </p>
  </div>
</section>

<style>
  .members {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 4rem;
  }

  .member {
    display: grid;
    align-content: start;
    gap: 1.5rem;
  }

  .member:nth-child(even) {
    margin-top: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .member__portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    background: var(--ink-2);
    overflow: hidden;
  }

  .member__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(0.9);
    transition: filter 1.2s var(--ease-out), transform 1.6s var(--ease-out);
  }

  .member:hover .member__portrait img {
    filter: grayscale(0.6) contrast(1.05) brightness(1);
    transform: scale(1.03);
  }

  .member__weave {
    position: absolute;
    left: 0.9rem;
    bottom: 0.8rem;
    color: var(--bone-2);
    opacity: 0.8;
  }

  .member__info {
    display: grid;
    gap: 0.75rem;
  }

  .member__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .member__name {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 1.3rem + 0.8vw, 2.1rem);
    line-height: 1.05;
  }

  .member__years {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--gold-2);
    line-height: 1;
  }

  .member__role {
    color: var(--bone-2);
  }

  .member__bio {
    color: var(--bone-2);
    font-size: var(--fs-s);
    line-height: 1.65;
    max-width: 34ch;
  }

  .member__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.25rem;
    font-size: var(--fs-s);
  }

  .member__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .member__links :global(svg) {
    width: 11px;
    height: 11px;
    color: var(--bone-3);
  }

  .team__note {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-top: clamp(3.5rem, 2rem + 4vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--bone-2);
    max-width: 60ch;
  }

  @media (max-width: 1100px) {
    .members {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .members {
      grid-template-columns: 1fr;
    }
    .member:nth-child(even) {
      margin-top: 0;
    }
    .member__portrait {
      aspect-ratio: 5 / 4;
    }
  }
</style>
