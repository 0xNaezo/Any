---
interface Props {
  milestone: string;
  spent: number;
  total: number;
}

const { milestone, spent, total } = Astro.props;
const pct = spent / total;
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
const steps = ['Discovery', 'Design', 'Core build', 'Beta', 'Launch'];
const current = 2;
---

<div class="budget" data-budget>
  <div class="budget-top">
    <span class="budget-milestone">{milestone}</span>
    <span class="budget-status"><span class="budget-status-dot"></span>On budget</span>
  </div>
  <div class="budget-bar" aria-hidden="true">
    <span class="budget-fill" style={`--p:${pct.toFixed(3)}`} data-budget-fill></span>
  </div>
  <div class="budget-nums">
    <span>
      <strong data-counter data-to={spent} data-prefix="$">{usd(spent)}</strong>
      <span class="budget-muted"> spent</span>
    </span>
    <span class="budget-muted">of {usd(total)} fixed</span>
  </div>
  <ol class="budget-steps" role="list">
    {
      steps.map((s, i) => (
        <li class:list={[i < current && 'is-done', i === current && 'is-current']}>
          <span class="budget-step-dot" aria-hidden="true" />
          <span class="budget-step-label">{s}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .budget {
    display: grid;
    gap: 0.9rem;
    padding: 1.15rem;
    border-radius: 18px;
    background: rgb(0 0 0 / 0.25);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .budget-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8rem;
  }

  .budget-milestone {
    font-weight: 520;
  }

  .budget-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    color: var(--ok);
    background: rgb(var(--ok-rgb) / 0.1);
    box-shadow: inset 0 0 0 1px rgb(var(--ok-rgb) / 0.25);
  }

  .budget-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .budget-bar {
    position: relative;
    height: 10px;
    border-radius: 999px;
    background: repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.04) 0 6px, rgb(255 255 255 / 0.07) 6px 12px);
    overflow: hidden;
  }

  .budget-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--p) * 100%);
    border-radius: inherit;
    background: var(--grad-accent);
    box-shadow: 0 0 16px rgb(var(--accent-rgb) / 0.6);
    transform-origin: left center;
  }

  .budget-nums {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8rem;
  }

  .budget-nums strong {
    font-size: 1.35rem;
    font-weight: 540;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .budget-muted {
    color: var(--text-3);
  }

  .budget-steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.3rem;
    padding: 0.4rem 0 0;
    margin: 0;
    list-style: none;
  }

  .budget-steps li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    text-align: center;
  }

  .budget-steps li + li::before {
    content: '';
    position: absolute;
    top: 5px;
    right: 50%;
    width: 100%;
    height: 1px;
    background: var(--line-2);
  }

  .budget-steps li.is-done + li::before,
  .budget-steps li.is-done + li.is-current::before {
    background: rgb(var(--accent-rgb) / 0.6);
  }

  .budget-step-dot {
    position: relative;
    z-index: 1;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: inset 0 0 0 1.5px var(--line-3);
  }

  .is-done .budget-step-dot {
    background: var(--accent);
    box-shadow: 0 0 8px rgb(var(--accent-rgb) / 0.7);
  }

  .is-current .budget-step-dot {
    background: var(--bg);
    box-shadow:
      inset 0 0 0 2px var(--accent-2),
      0 0 10px rgb(var(--accent-2-rgb) / 0.6);
  }

  .budget-step-label {
    font-size: 0.62rem;
    line-height: 1.2;
    color: var(--text-3);
  }

  .is-current .budget-step-label {
    color: var(--text);
  }
</style>
