---
import { zoneSegments, overlapHours, hoursNow, formatClock, type Zone } from '../../lib/time';

interface Props {
  zones: Zone[];
}

const { zones } = Astro.props;
const now = new Date();
const rows = zoneSegments(zones, now);
const home = rows.find((r) => r.home) ?? rows[0];
const ticks = [0, 6, 12, 18, 24];
const pos = (h: number) => (h / 24).toFixed(4);
---

<div class="tz" data-tz data-zones={JSON.stringify(zones)}>
  <div class="tz-grid">
    <span class="tz-corner mono">{home.city} time</span>
    <div class="tz-scale mono" aria-hidden="true">
      {ticks.map((t) => <span style={`--x:${pos(t)}`}>{String(t).padStart(2, '0')}</span>)}
    </div>

    {
      rows.map((row) => (
        <>
          <span class:list={['tz-city', row.home && 'tz-city--home']}>
            {row.city}
            <small class="mono" data-tz-clock={row.tz}>
              {formatClock(row.tz, now)}
            </small>
          </span>
          <div class:list={['tz-track', row.home && 'tz-track--home']} data-tz-track={row.tz}>
            {row.segments.map(([s, e]) => (
              <span class="tz-bar" style={`--s:${pos(s)};--e:${pos(e)}`} />
            ))}
            {!row.home &&
              row.segments.flatMap(([s, e]) =>
                home.segments
                  .map(([hs, he]) => [Math.max(s, hs), Math.min(e, he)] as const)
                  .filter(([a, b]) => b > a)
                  .map(([a, b]) => <span class="tz-bar tz-bar--overlap" style={`--s:${pos(a)};--e:${pos(b)}`} />),
              )}
          </div>
        </>
      ))
    }

    <div class="tz-now-wrap" aria-hidden="true">
      <span class="tz-now" style={`--x:${pos(hoursNow(home.tz, now))}`} data-tz-now>
        <span class="tz-now-label mono">now</span>
      </span>
    </div>
  </div>

  <ul class="tz-legend" role="list">
    {
      rows
        .filter((r) => !r.home)
        .map((r) => (
          <li>
            <strong data-tz-overlap={r.tz}>{overlapHours(r.segments, home.segments)}h</strong> overlap with {r.city}
          </li>
        ))
    }
  </ul>
</div>

<style>
  .tz {
    display: grid;
    gap: 1rem;
    padding: 1.15rem 1.2rem 1rem;
    border-radius: 18px;
    background: rgb(0 0 0 / 0.25);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .tz-grid {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem 0.9rem;
  }

  .tz-corner {
    font-size: 0.65rem;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tz-scale {
    position: relative;
    height: 1rem;
    font-size: 0.65rem;
    color: var(--text-3);
  }

  .tz-scale span {
    position: absolute;
    left: calc(var(--x) * 100%);
    transform: translateX(-50%);
  }

  .tz-scale span:first-child {
    transform: none;
  }

  .tz-scale span:last-child {
    transform: translateX(-100%);
  }

  .tz-city {
    display: grid;
    font-size: 0.8rem;
    line-height: 1.2;
    color: var(--text-2);
  }

  .tz-city small {
    font-size: 0.66rem;
    color: var(--text-3);
  }

  .tz-city--home {
    color: var(--text);
    font-weight: 520;
  }

  .tz-track {
    position: relative;
    height: 22px;
    border-radius: 7px;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px calc(100% / 24));
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .tz-bar {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: calc(var(--s) * 100%);
    width: calc((var(--e) - var(--s)) * 100%);
    border-radius: 5px;
    background: rgb(255 255 255 / 0.1);
    transform-origin: left center;
  }

  .tz-track--home .tz-bar {
    background: var(--grad-accent);
    box-shadow: 0 0 14px rgb(var(--accent-rgb) / 0.5);
  }

  .tz-bar--overlap {
    background: rgb(var(--accent-rgb) / 0.55);
    box-shadow: inset 0 0 0 1px rgb(var(--accent-rgb) / 0.6);
  }

  .tz-now-wrap {
    position: absolute;
    top: 1.4rem;
    bottom: 0;
    left: calc(6.5rem + 0.9rem);
    right: 0;
    pointer-events: none;
  }

  .tz-now {
    position: absolute;
    top: 0;
    bottom: -4px;
    left: calc(var(--x) * 100%);
    width: 1px;
    background: linear-gradient(180deg, #fff, rgb(255 255 255 / 0.15));
  }

  .tz-now::before {
    content: '';
    position: absolute;
    top: -3px;
    left: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 10px #fff;
  }

  .tz-now-label {
    position: absolute;
    top: -1.25rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 0.3rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text);
    background: var(--surface);
    border-radius: 4px;
  }

  .tz-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .tz-legend strong {
    color: var(--text);
    font-weight: 540;
  }

  @media (max-width: 480px) {
    .tz-grid {
      grid-template-columns: 5.2rem minmax(0, 1fr);
      column-gap: 0.6rem;
    }

    .tz-now-wrap {
      left: calc(5.2rem + 0.6rem);
    }
  }
</style>
