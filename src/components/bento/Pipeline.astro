---
interface Props {
  checks: { label: string; time: string }[];
}

const { checks } = Astro.props;
---

<div class="pipe" data-pipeline>
  <div class="pipe-head mono">
    <span><span class="pipe-branch">main</span> · a1f9c3e</span>
    <span class="pipe-state" data-pipe-state>Passed</span>
  </div>
  <ul class="pipe-list" role="list">
    {
      checks.map((c) => (
        <li class="pipe-step is-done" data-pipe-step>
          <span class="pipe-icon" aria-hidden="true">
            <svg class="pipe-spin" viewBox="0 0 16 16">
              <circle cx="8" cy="8" r="6" />
            </svg>
            <svg class="pipe-check" viewBox="0 0 16 16">
              <path d="m4.5 8.2 2.3 2.3 4.7-4.9" />
            </svg>
          </span>
          <span class="pipe-label">{c.label}</span>
          <span class="pipe-time mono">{c.time}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .pipe {
    border-radius: 18px;
    background: rgb(0 0 0 / 0.25);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }

  .pipe-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.05rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--text-3);
  }

  .pipe-branch {
    color: var(--text-2);
  }

  .pipe-state {
    color: var(--ok);
  }

  .pipe-list {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem;
    margin: 0;
    list-style: none;
  }

  .pipe-step {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.5rem;
    border-radius: 10px;
    font-size: 0.84rem;
    color: var(--text-3);
    transition:
      color 0.4s,
      background-color 0.4s;
  }

  .pipe-step.is-done {
    color: var(--text-2);
  }

  .pipe-step.is-running {
    color: var(--text);
    background: rgb(255 255 255 / 0.04);
  }

  .pipe-icon {
    position: relative;
    display: grid;
    width: 18px;
    height: 18px;
  }

  .pipe-icon svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out);
  }

  .pipe-spin {
    stroke: var(--text-3);
    stroke-dasharray: 26 12;
    opacity: 0;
  }

  .is-running .pipe-spin {
    opacity: 1;
    stroke: var(--accent);
    animation: spin 0.9s linear infinite;
  }

  .pipe-step:not(.is-done):not(.is-running) .pipe-spin {
    opacity: 0.6;
  }

  .pipe-check {
    stroke: #0b0b12;
    opacity: 0;
    transform: scale(0.4);
  }

  .is-done .pipe-icon::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 10px rgb(var(--ok-rgb) / 0.55);
  }

  .is-done .pipe-check {
    opacity: 1;
    transform: none;
  }

  .pipe-time {
    font-size: 0.7rem;
    color: var(--text-3);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
