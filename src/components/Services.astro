---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import type { Content } from '../i18n';

interface Props {
  t: Content;
  index: string;
}
const { t, index } = Astro.props;
const s = t.services;
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <SectionHead index={index} label={s.label} title={s.title} intro={s.intro} id="services-title" />

    <ol class="svc">
      {
        s.items.map((item, i) => (
          <li class="svc__row" data-reveal>
            <span class="svc__glow" aria-hidden="true" />
            <span class="label svc__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="svc__title">
              <a href="#contact" class="svc__link" data-prefill={s.prefill.replace('{item}', item.title)}>
                <span class="svc__text">{item.title}</span>
              </a>
            </h3>
            <div class="svc__body">
              <p>{item.text}</p>
              <ul class="tags">
                {item.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </div>
            <span class="svc__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" />
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .svc {
    border-top: 1px solid var(--line);
  }

  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(3rem, 1fr) 5fr 5fr 3rem;
    column-gap: var(--col-gap);
    align-items: start;
    padding: clamp(1.75rem, 1rem + 2vw, 2.75rem) 0;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
  }

  .svc__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgb(201 180 138 / 0.07), transparent 70%);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .svc__row:hover .svc__glow {
    opacity: 1;
  }

  .svc__num {
    padding-top: 0.9rem;
  }

  .svc__title {
    font-family: var(--f-display);
    font-weight: 300;
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.012em;
  }

  .svc__text {
    display: inline-block;
    transition:
      transform 0.8s var(--ease-out),
      color 0.6s var(--ease-out);
  }

  .svc__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .svc__link:focus-visible {
    outline: none;
  }

  .svc__row:has(.svc__link:focus-visible) {
    outline: 1px solid var(--gold);
    outline-offset: -1px;
  }

  .svc__row:hover .svc__text {
    transform: translateX(0.75rem);
    color: var(--gold-2);
  }

  .svc__body {
    display: grid;
    gap: 1.1rem;
    padding-top: 0.55rem;
  }

  .svc__body p {
    color: var(--bone-2);
    max-width: 44ch;
  }

  .svc__arrow {
    justify-self: end;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-top: 0.3rem;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    color: var(--bone-3);
    transition:
      transform 0.8s var(--ease-out),
      color 0.5s,
      border-color 0.5s;
  }

  .svc__row:hover .svc__arrow {
    transform: rotate(45deg);
    color: var(--bone);
    border-color: var(--line-3);
  }

  @media (max-width: 960px) {
    .svc__row {
      grid-template-columns: 3rem 1fr;
      row-gap: 1.1rem;
    }
    .svc__body {
      grid-column: 2;
      padding-top: 0;
    }
    .svc__arrow {
      display: none;
    }
    .svc__num {
      padding-top: 0.55rem;
    }
  }

  @media (max-width: 520px) {
    .svc__row {
      grid-template-columns: 1fr;
    }
    .svc__body {
      grid-column: 1;
    }
    .svc__num {
      padding-top: 0;
    }
  }
</style>
