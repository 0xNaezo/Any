---
import Pixel from './Pixel.astro';
import { GHOST } from '@/lib/sprites';
import { site } from '@/config/site';
import type { Dictionary } from '@/i18n';

interface Props {
  dict: Dictionary;
}

const { scene } = Astro.props.dict.hero;
---

<figure class="scene corners" data-scene>
  <span class="corner corner--tl"></span><span class="corner corner--tr"></span>
  <span class="corner corner--bl"></span><span class="corner corner--br"></span>

  <div class="scene__bar t-mono">
    <span>{scene.label}</span>
    <span class="scene__live"><span class="status-dot"></span>{scene.live}</span>
  </div>

  <div class="scene__viewport">
    <canvas class="scene__canvas" aria-hidden="true"></canvas>
    <Pixel rows={GHOST} cell={12} class="scene__fallback" />
    <p class="scene__hint t-mono" aria-hidden="true">{scene.hint}</p>
  </div>

  <figcaption class="scene__bar t-mono">
    <span data-scene-coords>X --- · Y ---</span>
    <span>
      {scene.city}
      <time class="scene__clock" data-clock data-tz={site.timezone}>--:--</time>
    </span>
  </figcaption>
</figure>

<style>
  .scene {
    --scene-bg: #0b0b0e;
    display: flex;
    flex-direction: column;
    background: var(--scene-bg);
    border: 1px solid var(--line-2);
    width: 100%;
    height: 100%;
    min-height: 420px;
  }

  .scene__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 14px;
    font-size: 11px;
    color: var(--fg-3);
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  figcaption.scene__bar {
    border-bottom: 0;
    border-top: 1px solid var(--line);
  }

  .scene__live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-2);
  }

  .scene__clock {
    color: var(--fg);
    margin-left: 6px;
    font-variant-numeric: tabular-nums;
  }

  .scene__viewport {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .scene__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: crosshair;
    touch-action: pan-y;
  }

  .scene__fallback {
    position: absolute;
    left: 50%;
    top: 46%;
    translate: -50% -50%;
    color: var(--fg);
  }

  .scene.is-live .scene__fallback {
    display: none;
  }

  .scene__hint {
    position: absolute;
    right: 14px;
    bottom: 12px;
    font-size: 10px;
    color: var(--fg-4);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s steps(3);
  }

  .scene.is-live:hover .scene__hint {
    opacity: 1;
  }

  @media (hover: none) {
    .scene__hint {
      display: none;
    }
  }
</style>
