---
/**
 * Case-study image with the pixel "depixelate" reveal and a duotone tint
 * that lifts on hover. Without an image it renders a generated placeholder,
 * so a missing screenshot never breaks the layout.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  /** Shown on the placeholder when there is no image. */
  label?: string;
  sizes?: string;
  eager?: boolean;
  /** CSS aspect-ratio, e.g. "16 / 10" */
  ratio?: string;
  class?: string;
}

const {
  image,
  alt,
  label = '',
  sizes = '(min-width: 1280px) 700px, (min-width: 960px) 55vw, 100vw',
  eager = false,
  ratio = '16 / 10',
  class: className,
} = Astro.props;
---

<div class:list={['wimg', className]} data-depixel style={`--ratio: ${ratio}`}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="wimg__img"
      />
    ) : (
      <div class="wimg__ph" role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
        <span class="px">{label}</span>
      </div>
    )
  }
  <canvas class="wimg__fx" aria-hidden="true"></canvas>
  <span class="wimg__tint" aria-hidden="true"></span>
</div>

<style>
  .wimg {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background:
      repeating-conic-gradient(rgb(143 181 255 / 0.1) 0 25%, transparent 0 50%) 0 0 / 8px 8px,
      var(--bg-2);
    isolation: isolate;
  }
  .wimg__img,
  .wimg__ph,
  .wimg__fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wimg__img {
    object-fit: cover;
    object-position: top left;
    filter: grayscale(1) contrast(1.1) brightness(0.86);
    transition:
      filter 360ms steps(4),
      opacity 200ms steps(2);
  }
  .wimg__fx {
    image-rendering: pixelated;
    opacity: 0;
    pointer-events: none;
  }
  .wimg__tint {
    position: absolute;
    inset: 0;
    background: #6d92ec;
    mix-blend-mode: multiply;
    pointer-events: none;
    transition: opacity 360ms steps(4);
  }
  .wimg__ph {
    display: grid;
    place-items: center;
    color: var(--accent);
    font-size: 32px;
  }

  /* hidden until the depixelate effect has played */
  :global(.js:not(.reduced):not(.reveal-fallback)) .wimg:not(:global(.is-revealed)) .wimg__img {
    opacity: 0;
  }

  /* true colours on hover/focus of the surrounding link or card */
  :global(a:hover) > .wimg .wimg__img,
  :global(a:focus-visible) > .wimg .wimg__img,
  :global(.wimg-host:hover) .wimg .wimg__img {
    filter: none;
  }
  :global(a:hover) > .wimg .wimg__tint,
  :global(a:focus-visible) > .wimg .wimg__tint,
  :global(.wimg-host:hover) .wimg .wimg__tint {
    opacity: 0;
  }
</style>
