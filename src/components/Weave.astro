---
/**
 * A woven portrait placeholder: every team member gets their own classic weave.
 * Rendered as a tiny repeating SVG pattern — a few hundred bytes each.
 */
interface Props {
  weave: 'twill' | 'herringbone' | 'diamond' | 'houndstooth';
  initials: string;
  id: string;
}
const { weave, initials, id } = Astro.props;

type Cell = { up: boolean; light: boolean };
const size = { twill: [4, 4], herringbone: [8, 4], diamond: [8, 8], houndstooth: [8, 8] }[weave];
const [W, H] = size;
const cells: Cell[] = [];
for (let y = 0; y < H; y++) {
  for (let x = 0; x < W; x++) {
    let up = false;
    let light = true;
    if (weave === 'twill') up = (x + y) % 4 < 2;
    if (weave === 'herringbone') up = (x < 4 ? x + y : x - y + 8) % 4 < 2;
    if (weave === 'diamond') {
      const dx = Math.min(x, 7 - x);
      const dy = Math.min(y, 7 - y);
      up = (dx + dy) % 4 < 2;
    }
    if (weave === 'houndstooth') {
      // 2/2 twill with a 4-dark/4-light colour order in both directions
      up = (x + y) % 4 < 2;
      light = up ? x % 8 < 4 : y % 8 >= 4;
    } else {
      light = up; // warp threads are pale, weft threads are ink
    }
    cells.push({ up, light });
  }
}
const c = 11; // cell size in SVG units
---

<svg class="weave" viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-v`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" style="stop-color: var(--w-shade)" />
      <stop offset="0.45" style="stop-color: var(--w-hi)" />
      <stop offset="1" style="stop-color: var(--w-shade)" />
    </linearGradient>
    <linearGradient id={`${id}-h`} x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" style="stop-color: var(--w-shade)" />
      <stop offset="0.45" style="stop-color: var(--w-hi)" />
      <stop offset="1" style="stop-color: var(--w-shade)" />
    </linearGradient>
    <linearGradient id={`${id}-dv`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" style="stop-color: var(--w-ink-shade)" />
      <stop offset="0.45" style="stop-color: var(--w-ink)" />
      <stop offset="1" style="stop-color: var(--w-ink-shade)" />
    </linearGradient>
    <linearGradient id={`${id}-dh`} x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" style="stop-color: var(--w-ink-shade)" />
      <stop offset="0.45" style="stop-color: var(--w-ink)" />
      <stop offset="1" style="stop-color: var(--w-ink-shade)" />
    </linearGradient>
    <pattern id={`${id}-p`} width={W * c} height={H * c} patternUnits="userSpaceOnUse">
      <rect width={W * c} height={H * c} style="fill: var(--w-gap)" />
      {
        cells.map((cell, i) => {
          const x = (i % W) * c;
          const y = Math.floor(i / W) * c;
          const fill = cell.up ? (cell.light ? `url(#${id}-v)` : `url(#${id}-dv)`) : cell.light ? `url(#${id}-h)` : `url(#${id}-dh)`;
          return cell.up ? (
            <rect x={x + 1.2} y={y} width={c - 2.4} height={c} rx="3" fill={fill} />
          ) : (
            <rect x={x} y={y + 1.2} width={c} height={c - 2.4} rx="3" fill={fill} />
          );
        })
      }
    </pattern>
    <radialGradient id={`${id}-vig`} cx="0.5" cy="0.42" r="0.75">
      <stop offset="0" stop-color="#08090c" stop-opacity="0.3" />
      <stop offset="1" stop-color="#08090c" stop-opacity="0.94" />
    </radialGradient>
    <linearGradient id={`${id}-sheen`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0.35" stop-color="#fff" stop-opacity="0" />
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.16" />
      <stop offset="0.65" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
  </defs>
  <rect class="weave__cloth" x="-40" y="-40" width="480" height="580" fill={`url(#${id}-p)`} />
  <rect width="400" height="500" fill={`url(#${id}-vig)`} />
  <rect class="weave__sheen" x="-400" y="-500" width="1200" height="1500" fill={`url(#${id}-sheen)`} />
  <text class="weave__mono" x="200" y="292" text-anchor="middle">{initials}</text>
</svg>

<style is:global>
  .weave {
    --w-hi: #7b766d;
    --w-shade: #34322f;
    --w-ink: #1d1f26;
    --w-ink-shade: #0b0c10;
    --w-gap: #060709;
    width: 100%;
    height: 100%;
    display: block;
  }

  .weave__cloth {
    transition: transform 2.4s var(--ease-out);
  }

  .weave__sheen {
    transform: translate(-30%, -30%);
    transition: transform 2s var(--ease-out);
  }

  .member:hover .weave__cloth {
    transform: translate(-14px, -10px);
  }

  .member:hover .weave__sheen {
    transform: translate(30%, 30%);
  }

  .weave__mono {
    font-family: var(--f-display);
    font-style: italic;
    font-weight: 300;
    font-size: 150px;
    letter-spacing: -0.02em;
    fill: var(--bone);
  }
</style>
