---
import Icon from './Icon.astro';
import Button from './Button.astro';
import type { Content } from '../i18n';

interface Props {
  t: Content;
  index: string;
}
const { t, index } = Astro.props;
const f = t.faq;
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__aside">
      <div class="faq__sticky">
        <div class="sh__top">
          <span class="label label--bright" data-reveal>{index}</span>
          <span class="label" data-reveal>{f.label}</span>
        </div>
        <h2 class="h2 faq__title" id="faq-title" data-split set:html={f.title} />
        <div class="faq__help" data-reveal>
          <p class="faq__help-title">{f.asideTitle}</p>
          <p class="faq__help-text">{f.asideText}</p>
          <Button href="#contact" variant="ghost" size="sm">{f.asideCta}</Button>
        </div>
      </div>
    </div>

    <ul class="faq__list">
      {
        f.items.map((item, i) => (
          <li class="qa" data-reveal>
            <h3 class="qa__q">
              <button type="button" class="qa__btn" aria-expanded="false" aria-controls={`faq-${i}`} id={`faq-q-${i}`} data-faq>
                <span class="label qa__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="qa__text">{item.q}</span>
                <span class="qa__icon" aria-hidden="true">
                  <Icon name="plus" />
                </span>
              </button>
            </h3>
            <div class="qa__panel" id={`faq-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div class="qa__inner">
                <p>{item.a}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: f.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  })}
/>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 3rem;
  }

  .faq__aside {
    grid-column: 1 / span 5;
  }

  .faq__sticky {
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
    display: grid;
    gap: clamp(2rem, 1rem + 2vw, 3rem);
  }

  .faq__help {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    max-width: 22rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .faq__help-title {
    font-family: var(--f-display);
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .faq__help-text {
    color: var(--bone-2);
    font-size: var(--fs-s);
    margin-bottom: 0.5rem;
  }

  .faq__list {
    grid-column: 7 / span 6;
    border-top: 1px solid var(--line);
  }

  .qa {
    border-bottom: 1px solid var(--line);
  }

  .qa__btn {
    width: 100%;
    display: grid;
    grid-template-columns: 2.5rem 1fr 2.25rem;
    align-items: center;
    gap: 0.75rem;
    padding: 1.6rem 0;
    text-align: left;
  }

  .qa__text {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.65rem);
    line-height: 1.2;
    transition: color 0.4s;
  }

  .qa__btn:hover .qa__text {
    color: var(--gold-2);
  }

  .qa__icon {
    justify-self: end;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    transition:
      transform 0.6s var(--ease-out),
      border-color 0.4s,
      background-color 0.4s;
  }

  .qa__icon :global(svg) {
    width: 13px;
    height: 13px;
  }

  .qa__btn[aria-expanded='true'] .qa__icon {
    transform: rotate(135deg);
    border-color: var(--gold);
    background: rgb(201 180 138 / 0.1);
  }

  .qa__panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  :global(.js) .qa__panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.7s var(--ease-out);
  }

  :global(.js) .qa.is-open .qa__panel {
    grid-template-rows: 1fr;
  }

  .qa__inner {
    overflow: hidden;
  }

  :global(.js) .qa__inner {
    visibility: hidden;
    transition: visibility 0s linear 0.7s;
  }

  :global(.js) .qa.is-open .qa__inner {
    visibility: visible;
    transition-delay: 0s;
  }

  .qa__inner p {
    padding: 0 3rem 1.75rem 3.25rem;
    color: var(--bone-2);
    max-width: 60ch;
  }

  @media (max-width: 960px) {
    .faq__aside,
    .faq__list {
      grid-column: 1 / -1;
    }
    .faq__sticky {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .qa__btn {
      grid-template-columns: 1fr 2.25rem;
    }
    .qa__num {
      display: none;
    }
    .qa__inner p {
      padding: 0 0 1.5rem;
    }
  }
</style>
