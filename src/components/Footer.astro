---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../site.config';
import { getContent, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  page?: string;
}
const { locale, page = '' } = Astro.props;
const t = getContent(locale);
const ft = t.footer;
const home = localePath(locale);
const anchor = (hash: string) => (page === '' ? hash : `${home}${hash}`);
const year = new Date().getFullYear();
---

<footer class="footer" aria-labelledby="footer-title">
  <h2 class="visually-hidden" id="footer-title">Nightloom</h2>
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href={home} aria-label={t.a11y.home}><Logo size={26} /></a>
        <p class="footer__tagline">{ft.tagline}</p>
      </div>

      <nav class="footer__col" aria-label={ft.columns.studio}>
        <p class="label">{ft.columns.studio}</p>
        <ul>
          {
            t.nav.links.map((l) => (
              <li>
                <a class="link" href={anchor(l.href)}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__col">
        <p class="label">{ft.columns.contact}</p>
        <ul>
          <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="link" href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener">Telegram</a></li>
          <li><a class="link" href={site.calendar} target="_blank" rel="noopener">{t.contact.direct.call}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <p class="label">{ft.columns.elsewhere}</p>
        <ul>
          {
            site.socials.map((s) => (
              <li>
                <a class="link footer__ext" href={s.href} target="_blank" rel="noopener">
                  {s.label}
                  <Icon name="arrow-up-right" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer__mark" aria-hidden="true" data-footer-mark>
      <span class="footer__word">Nightloom</span>
    </div>

    <div class="footer__bottom">
      <p class="label footer__legal">
        © {site.founded}–{year} {site.legal.company} · {site.legal.registration} · {site.legal.address}. {ft.rights}
      </p>
      <div class="footer__night label">
        <span class="footer__clock">
          {ft.localTime} <time data-clock data-tz={site.timezone} data-locale={t.htmlLang}>--:--</time>
        </span>
        <span class="footer__moon" data-moon data-phases={JSON.stringify(ft.phases)}>
          <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
            <circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor" stroke-opacity="0.35"></circle>
            <path data-moon-lit fill="currentColor" d=""></path>
          </svg>
          {ft.moon}: <span data-moon-name>—</span>
        </span>
      </div>
      <div class="footer__links">
        <a class="label link" href={localePath(locale, 'privacy')}>{ft.privacy}</a>
        <a class="label footer__top-link" href="#top" data-to-top>
          {ft.top}
          <Icon name="arrow-up" />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(4rem, 2rem + 6vw, 7rem);
    border-top: 1px solid var(--line);
    background: radial-gradient(80% 50% at 50% 100%, rgb(201 180 138 / 0.05), transparent 70%), var(--ink-0);
    overflow: hidden;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 5fr repeat(3, 2.3fr);
    gap: 3rem var(--col-gap);
  }

  .footer__brand {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .footer__tagline {
    color: var(--bone-2);
    max-width: 28ch;
  }

  .footer__col {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .footer__col ul {
    display: grid;
    gap: 0.6rem;
    font-size: var(--fs-s);
    color: var(--bone-2);
  }

  .footer__col a:hover {
    color: var(--bone);
  }

  .footer__ext {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .footer__ext :global(svg) {
    width: 11px;
    height: 11px;
    color: var(--bone-3);
  }

  .footer__mark {
    margin-top: clamp(4rem, 2rem + 7vw, 9rem);
    line-height: 0.74;
    text-align: center;
    user-select: none;
  }

  .footer__word {
    display: inline-block;
    font-family: var(--f-display);
    font-weight: 300;
    font-size: clamp(5rem, -0.6rem + 21.5vw, 22rem);
    letter-spacing: -0.035em;
    white-space: nowrap;
    background: linear-gradient(180deg, rgb(235 231 223 / 0.92) 10%, rgb(235 231 223 / 0.08) 92%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform-origin: 50% 100%;
  }

  .footer__bottom {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding-block: 1.6rem 2rem;
    border-top: 1px solid var(--line);
  }

  .footer__legal {
    text-transform: none;
    letter-spacing: 0.04em;
    max-width: 64ch;
  }

  .footer__night {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer__clock time {
    color: var(--bone-2);
    font-variant-numeric: tabular-nums;
  }

  .footer__moon {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__moon svg {
    color: var(--gold-2);
  }

  .footer__moon [data-moon-name] {
    color: var(--bone-2);
  }

  .footer__links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.3s;
  }

  .footer__top-link:hover {
    color: var(--bone);
  }

  .footer__top-link :global(svg) {
    width: 12px;
    height: 12px;
    transition: transform 0.6s var(--ease-out);
  }

  .footer__top-link:hover :global(svg) {
    transform: translateY(-3px);
  }

  @media (max-width: 960px) {
    .footer__top {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
