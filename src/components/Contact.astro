---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../site.config';
import type { Content } from '../i18n';

interface Props {
  t: Content;
  index: string;
}
const { t, index } = Astro.props;
const c = t.contact;
const f = c.form;
const messages = {
  required: f.required,
  invalidEmail: f.invalidEmail,
  tooShort: f.tooShort,
  sending: f.sending,
  submit: f.submit,
  subject: f.subject,
};
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="sh__top">
      <span class="label label--bright" data-reveal>{index}</span>
      <span class="label" data-reveal>{c.label}</span>
      <span class="thread" data-line aria-hidden="true"></span>
    </div>

    <div class="contact__head">
      <h2 class="contact__title" id="contact-title" data-split set:html={c.title} />
      <p class="lede contact__intro" data-reveal>{c.intro}</p>
    </div>

    <div class="contact__grid">
      <div class="contact__form-wrap" data-reveal>
        <form class="form" data-form data-endpoint={site.formEndpoint} data-email={site.email} data-messages={JSON.stringify(messages)} novalidate>
          <div class="form__row">
            <div class="field">
              <label for="f-name" class="label">{f.name}</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" />
              <p class="field__error" id="f-name-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="f-email" class="label">{f.email}</label>
              <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="160" />
              <p class="field__error" id="f-email-error" aria-live="polite"></p>
            </div>
          </div>

          <div class="field">
            <label for="f-company" class="label">
              {f.company} <span class="field__opt">· {f.optional}</span>
            </label>
            <input id="f-company" name="company" type="text" autocomplete="organization" maxlength="160" />
          </div>

          <fieldset class="field field--chips">
            <legend class="label">{f.budget}</legend>
            <div class="chips">
              {
                f.budgets.map((b, i) => (
                  <label class="chip">
                    <input type="radio" name="budget" value={b} checked={i === f.budgets.length - 1} />
                    <span>{b}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label for="f-message" class="label">{f.message}</label>
            <textarea id="f-message" name="message" rows="5" required minlength="20" maxlength="4000" placeholder={f.messagePlaceholder}></textarea>
            <p class="field__error" id="f-message-error" aria-live="polite"></p>
          </div>

          <div class="hp" aria-hidden="true">
            <label for="f-website">Website</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form__foot">
            <button type="submit" class="btn btn--primary form__submit">
              <span class="btn__label" data-submit-label>{f.submit}</span>
              <span class="btn__arrow" aria-hidden="true">
                <Icon name="arrow-right" />
                <Icon name="arrow-right" />
              </span>
            </button>
            <p class="form__privacy">{f.privacy}</p>
          </div>
          <p class="form__error" data-form-error role="alert" hidden>
            {f.error} <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </form>

        <div class="form-done" data-form-done hidden tabindex="-1">
          <Logo size={44} wordmark={false} class="form-done__ghost" />
          <p class="form-done__title" data-done-title data-success={f.successTitle} data-mailto={f.mailtoTitle}>{f.successTitle}</p>
          <p class="form-done__text">
            <span data-done-text data-success={f.successText} data-mailto={f.mailtoText}>{f.successText}</span>
            <a class="link" data-done-email href={`mailto:${site.email}`} hidden>{site.email}</a>
          </p>
          <button type="button" class="btn btn--ghost btn--sm" data-form-again>
            <span class="btn__label">{f.again}</span>
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-right" />
              <Icon name="arrow-right" />
            </span>
          </button>
        </div>
      </div>

      <aside class="contact__aside" data-reveal>
        <div class="direct">
          <p class="label">{c.direct.title}</p>
          <div class="direct__email">
            <a href={`mailto:${site.email}`} class="direct__big">{site.email}</a>
            <button type="button" class="direct__copy" data-copy={site.email} data-copied={c.direct.copied}>
              <Icon name="copy" />
              <span data-copy-label>{c.direct.copy}</span>
            </button>
          </div>
          <a class="direct__line" href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener">
            <span class="label">{c.direct.telegram}</span>
            <span>@{site.telegram}</span>
            <Icon name="arrow-up-right" />
          </a>
          <a class="direct__line direct__line--call" href={site.calendar} target="_blank" rel="noopener">
            <span class="label">{c.direct.call}</span>
            <span class="direct__call-text">{c.direct.callText}</span>
            <Icon name="arrow-up-right" />
          </a>
        </div>

        <div class="next">
          <p class="label">{c.next.title}</p>
          <ol class="next__list">
            {
              c.next.steps.map((step, i) => (
                <li>
                  <span class="next__num">{i + 1}</span>
                  <span>{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(5rem, 3rem + 6vw, 9rem);
  }

  .contact .sh__top {
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .contact__head {
    display: grid;
    gap: 2rem;
    margin-bottom: clamp(3.5rem, 2rem + 5vw, 7rem);
  }

  .contact__title {
    font-family: var(--f-display);
    font-weight: 300;
    font-size: clamp(3.2rem, 1.2rem + 7.4vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.022em;
    max-width: 13ch;
    text-wrap: balance;
  }

  .contact__title :global(em) {
    font-style: italic;
    color: var(--gold-2);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 4rem;
  }

  .contact__form-wrap {
    grid-column: 1 / span 7;
  }

  .contact__aside {
    grid-column: 9 / span 4;
    display: grid;
    align-content: start;
    gap: 3rem;
  }

  /* ---------- form ---------- */

  .form {
    display: grid;
    gap: 2.25rem;
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.25rem var(--col-gap);
  }

  .field {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .field__opt {
    color: var(--bone-4);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.6rem 0 0.75rem;
    border: 0;
    border-bottom: 1px solid var(--line-2);
    border-radius: 0;
    background: transparent;
    color: var(--bone);
    font-size: 1.125rem;
    line-height: 1.5;
    outline: none;
    transition: border-color 0.4s var(--ease-out);
    resize: vertical;
  }

  .field textarea {
    min-height: 8.5rem;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--bone-4);
  }

  .field input:hover,
  .field textarea:hover {
    border-bottom-color: var(--line-3);
  }

  .field input:focus,
  .field textarea:focus {
    border-bottom-color: var(--gold);
  }

  .field input:-webkit-autofill {
    -webkit-text-fill-color: var(--bone);
    box-shadow: 0 0 0 100px var(--ink-1) inset;
    caret-color: var(--bone);
  }

  :global(.field.is-invalid) input,
  :global(.field.is-invalid) textarea {
    border-bottom-color: #d58f7c;
  }

  .field__error {
    min-height: 1.2em;
    margin-top: -0.1rem;
    font-size: 0.8125rem;
    color: #e2a796;
  }

  .field--chips legend {
    margin-bottom: 0.9rem;
    padding: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    position: relative;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    height: 42px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--bone-2);
    font-size: 0.875rem;
    transition:
      border-color 0.4s,
      background-color 0.4s,
      color 0.4s;
  }

  .chip:hover span {
    border-color: var(--line-3);
    color: var(--bone);
  }

  .chip input:checked + span {
    background: var(--bone);
    border-color: var(--bone);
    color: var(--ink-1);
  }

  .chip input:focus-visible + span {
    outline: 1px solid var(--gold);
    outline-offset: 3px;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__foot {
    display: flex;
    align-items: center;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  .form__privacy {
    flex: 1;
    min-width: 16rem;
    font-size: 0.8125rem;
    color: var(--bone-3);
    max-width: 34ch;
  }

  .form__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .form__error {
    color: #e2a796;
    font-size: var(--fs-s);
  }

  .form-done {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(2rem, 1rem + 3vw, 3.5rem);
    border: 1px solid var(--line-2);
    background: radial-gradient(90% 70% at 0% 0%, rgb(201 180 138 / 0.08), transparent 70%), var(--ink-2);
    outline: none;
  }

  .form-done[hidden] {
    display: none;
  }

  .form-done :global(.form-done__ghost) {
    color: var(--gold-2);
    animation: nl-float 5s var(--ease-in-out) infinite;
  }

  @keyframes nl-float {
    50% {
      transform: translateY(-6px);
    }
  }

  .form-done__title {
    font-family: var(--f-display);
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.6rem);
    font-weight: 300;
    line-height: 1;
  }

  .form-done__text {
    color: var(--bone-2);
    max-width: 44ch;
  }

  /* ---------- aside ---------- */

  .direct {
    display: grid;
    gap: 1.25rem;
  }

  .direct__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .direct__big {
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2.1rem);
    line-height: 1.1;
    transition: color 0.4s;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .direct__big:hover {
    color: var(--gold-2);
  }

  .direct__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    height: 34px;
    padding: 0 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bone-2);
    transition: border-color 0.4s, color 0.4s;
  }

  .direct__copy:hover {
    border-color: var(--line-3);
    color: var(--bone);
  }

  .direct__copy :global(svg) {
    width: 12px;
    height: 12px;
  }

  .direct__line {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
    align-items: center;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .direct__line .label {
    grid-column: 1;
  }

  .direct__line > span:not(.label) {
    grid-column: 1;
    font-size: 1.05rem;
    transition: color 0.4s;
  }

  .direct__line :global(svg) {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 14px;
    height: 14px;
    color: var(--bone-3);
    transition: transform 0.6s var(--ease-out), color 0.4s;
  }

  .direct__line:hover > span:not(.label) {
    color: var(--gold-2);
  }

  .direct__line:hover :global(svg) {
    transform: translate(3px, -3px);
    color: var(--bone);
  }

  .direct__call-text {
    color: var(--bone-2);
    font-size: var(--fs-s) !important;
  }

  .next {
    display: grid;
    gap: 1.25rem;
  }

  .next__list {
    display: grid;
    gap: 1rem;
    counter-reset: n;
  }

  .next__list li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    color: var(--bone-2);
    font-size: var(--fs-s);
    line-height: 1.6;
  }

  .next__num {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid rgb(201 180 138 / 0.4);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    color: var(--gold);
  }

  @media (max-width: 1024px) {
    .contact__form-wrap,
    .contact__aside {
      grid-column: 1 / -1;
    }
    .contact__aside {
      grid-template-columns: 1fr 1fr;
      gap: 3rem var(--col-gap);
    }
  }

  @media (max-width: 720px) {
    .form__row {
      grid-template-columns: 1fr;
    }
    .contact__aside {
      grid-template-columns: 1fr;
    }
  }
</style>
