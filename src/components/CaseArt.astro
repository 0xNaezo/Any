---
/**
 * Placeholder product illustrations for the case studies (5:4).
 * Set `image` on a case in src/i18n/*.ts to use a real screenshot instead.
 */
interface Props {
  variant: 'halcyon' | 'lumen' | 'morrow' | 'arcwell';
  class?: string;
}
const { variant, class: className } = Astro.props;
const uid = `art-${variant}`;
---

<svg class:list={['art', className]} viewBox="0 0 1000 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {
    variant === 'halcyon' && (
      <>
        <defs>
          <radialGradient id={`${uid}-bg`} cx="0.82" cy="0.05" r="1.05">
            <stop offset="0" stop-color="#1b2a2a" />
            <stop offset="0.55" stop-color="#0c1213" />
            <stop offset="1" stop-color="#08090b" />
          </radialGradient>
          <linearGradient id={`${uid}-area`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8fc7bd" stop-opacity="0.28" />
            <stop offset="1" stop-color="#8fc7bd" stop-opacity="0" />
          </linearGradient>
        </defs>
        <rect width="1000" height="800" fill={`url(#${uid}-bg)`} />
        <g class="art__window">
          <rect x="110" y="110" width="930" height="760" rx="14" fill="#0d1315" stroke="#ffffff" stroke-opacity="0.08" />
          <path d="M110 124a14 14 0 0 1 14-14h166v760H124a14 14 0 0 1-14-14Z" fill="#0a0f10" />
          <circle cx="150" cy="160" r="9" fill="none" stroke="#8fc7bd" stroke-width="2" />
          <circle cx="150" cy="160" r="3.5" fill="#8fc7bd" />
          <rect x="168" y="155" width="70" height="10" rx="5" fill="#ebe7df" fill-opacity="0.75" />
          <rect x="128" y="214" width="146" height="34" rx="8" fill="#8fc7bd" fill-opacity="0.12" />
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <g>
              <rect x="142" y={226 + i * 46} width="12" height="10" rx="3" fill="#ebe7df" fill-opacity={i === 0 ? 0.8 : 0.22} />
              <rect x="164" y={227 + i * 46} width={[78, 64, 88, 56, 70, 60][i]} height="8" rx="4" fill="#ebe7df" fill-opacity={i === 0 ? 0.8 : 0.22} />
            </g>
          ))}
          <text x="330" y="172" class="art__h">Treasury overview</text>
          <rect x="820" y="148" width="92" height="34" rx="17" fill="none" stroke="#ffffff" stroke-opacity="0.12" />
          <text x="866" y="170" class="art__s" text-anchor="middle">Q3 2025</text>
          <rect x="924" y="148" width="92" height="34" rx="17" fill="#ebe7df" fill-opacity="0.9" />
          <text x="970" y="170" class="art__s art__s--ink" text-anchor="middle">Export</text>

          {[
            { x: 330, label: 'Total liquidity', value: '€ 4.28M', delta: '+2.4%' },
            { x: 548, label: 'Reconciled', value: '99.6%', delta: '+11.2%' },
            { x: 766, label: 'Open items', value: '12', delta: '−84%' },
          ].map((k) => (
            <g>
              <rect x={k.x} y="214" width="200" height="104" rx="10" fill="#ffffff" fill-opacity="0.025" stroke="#ffffff" stroke-opacity="0.06" />
              <text x={k.x + 20} y="246" class="art__s">{k.label}</text>
              <text x={k.x + 20} y="288" class="art__kpi">{k.value}</text>
              <text x={k.x + 180} y="288" class="art__s art__s--accent" text-anchor="end">{k.delta}</text>
            </g>
          ))}

          <g stroke="#ffffff" stroke-opacity="0.06" stroke-dasharray="3 6">
            <path d="M330 380H986M330 450H986M330 520H986M330 590H986" />
          </g>
          <path
            d="M330 560C380 552 400 520 450 526S520 560 566 540 630 470 680 476 740 520 790 492 850 420 900 430 960 400 986 396V620H330Z"
            fill={`url(#${uid}-area)`}
          />
          <path
            d="M330 560C380 552 400 520 450 526S520 560 566 540 630 470 680 476 740 520 790 492 850 420 900 430 960 400 986 396"
            fill="none"
            stroke="#a9d6cc"
            stroke-width="2.5"
          />
          <path d="M790 380V620" stroke="#ebe7df" stroke-opacity="0.25" />
          <circle cx="790" cy="492" r="6" fill="#0d1315" stroke="#ebe7df" stroke-width="2" />
          <rect x="806" y="430" width="150" height="52" rx="8" fill="#141c1e" stroke="#ffffff" stroke-opacity="0.1" />
          <text x="822" y="452" class="art__s">Sep 18</text>
          <text x="822" y="472" class="art__m">€ 4,281,940</text>

          {[0, 1, 2].map((i) => (
            <g>
              <path d={`M330 ${660 + i * 52}H986`} stroke="#ffffff" stroke-opacity="0.06" />
              <text x="330" y={693 + i * 52} class="art__m">{['EUR', 'USD', 'GBP'][i]}</text>
              <rect x="400" y={683 + i * 52} width={[180, 120, 90][i]} height="8" rx="4" fill="#ebe7df" fill-opacity="0.18" />
              <rect x="700" y={683 + i * 52} width="60" height="8" rx="4" fill="#8fc7bd" fill-opacity="0.45" />
              <text x="986" y={693 + i * 52} class="art__m" text-anchor="end">{['2,940,112.40', '1,018,560.00', '323,267.72'][i]}</text>
            </g>
          ))}
        </g>
      </>
    )
  }

  {
    variant === 'lumen' && (
      <>
        <defs>
          <radialGradient id={`${uid}-bg`} cx="0.25" cy="0.1" r="1.1">
            <stop offset="0" stop-color="#261c2e" />
            <stop offset="0.55" stop-color="#110d15" />
            <stop offset="1" stop-color="#08080b" />
          </radialGradient>
          <linearGradient id={`${uid}-screen`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#17121c" />
            <stop offset="1" stop-color="#0e0b11" />
          </linearGradient>
        </defs>
        <rect width="1000" height="800" fill={`url(#${uid}-bg)`} />

        <g opacity="0.55" class="art__phone-back">
          <rect x="590" y="190" width="300" height="640" rx="44" fill="#0c0a0e" stroke="#ffffff" stroke-opacity="0.1" />
          <rect x="604" y="204" width="272" height="612" rx="34" fill={`url(#${uid}-screen)`} />
          <text x="630" y="272" class="art__h">September</text>
          {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d, i) => (
            <g>
              <text x={642 + i * 34} y="316" class="art__s" text-anchor="middle">{d}</text>
              <circle cx={642 + i * 34} cy="344" r="13" fill={i === 3 ? '#c4b2d9' : 'none'} stroke="#ffffff" stroke-opacity={i === 3 ? 0 : 0.12} />
              <text x={642 + i * 34} y="349" class={i === 3 ? 'art__s art__s--ink' : 'art__s'} text-anchor="middle">{15 + i}</text>
            </g>
          ))}
          {[0, 1, 2, 3].map((i) => (
            <g>
              <rect x="626" y={392 + i * 78} width="228" height="64" rx="14" fill="#ffffff" fill-opacity="0.03" stroke="#ffffff" stroke-opacity="0.07" />
              <circle cx="656" cy={424 + i * 78} r="12" fill="#c4b2d9" fill-opacity={0.5 - i * 0.1} />
              <rect x="680" y={414 + i * 78} width={[120, 96, 132, 84][i]} height="8" rx="4" fill="#ebe7df" fill-opacity="0.5" />
              <rect x="680" y={430 + i * 78} width={[70, 90, 60, 76][i]} height="7" rx="3.5" fill="#ebe7df" fill-opacity="0.2" />
            </g>
          ))}
        </g>

        <g class="art__phone">
          <rect x="250" y="100" width="340" height="740" rx="50" fill="#0d0b0f" stroke="#ffffff" stroke-opacity="0.14" />
          <rect x="265" y="115" width="310" height="710" rx="38" fill={`url(#${uid}-screen)`} />
          <rect x="378" y="132" width="84" height="22" rx="11" fill="#000000" />
          <text x="292" y="146" class="art__s">21:04</text>
          <text x="292" y="214" class="art__s">Good evening,</text>
          <text x="292" y="248" class="art__h art__h--lg">Anna</text>
          <circle cx="420" cy="380" r="92" fill="none" stroke="#ffffff" stroke-opacity="0.08" stroke-width="10" />
          <circle
            cx="420"
            cy="380"
            r="92"
            fill="none"
            stroke="#c4b2d9"
            stroke-width="10"
            stroke-linecap="round"
            stroke-dasharray="497 578"
            transform="rotate(-90 420 380)"
          />
          <text x="420" y="390" class="art__kpi art__kpi--lg" text-anchor="middle">86%</text>
          <text x="420" y="418" class="art__s" text-anchor="middle">on track this week</text>
          <rect x="290" y="510" width="260" height="92" rx="18" fill="#c4b2d9" fill-opacity="0.1" stroke="#c4b2d9" stroke-opacity="0.25" />
          <text x="312" y="542" class="art__s">Next dose · 21:30</text>
          <text x="312" y="574" class="art__m">Metformin 500 mg</text>
          <rect x="486" y="532" width="44" height="44" rx="22" fill="#ebe7df" fill-opacity="0.9" />
          <path d="m498 554 7 7 13-14" fill="none" stroke="#0d0b0f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="290" y="622" width="260" height="120" rx="18" fill="#ffffff" fill-opacity="0.03" stroke="#ffffff" stroke-opacity="0.07" />
          <text x="312" y="654" class="art__s">Sleep</text>
          <text x="528" y="654" class="art__m" text-anchor="end">7h 40m</text>
          <path d="M312 716c20-4 30-30 50-26s26 24 46 20 30-34 50-32 26 22 46 18 20-14 24-16" fill="none" stroke="#c4b2d9" stroke-width="2.5" stroke-linecap="round" />
          <rect x="370" y="800" width="100" height="5" rx="2.5" fill="#ebe7df" fill-opacity="0.5" />
        </g>
      </>
    )
  }

  {
    variant === 'morrow' && (
      <>
        <defs>
          <radialGradient id={`${uid}-bg`} cx="0.3" cy="0.0" r="1.1">
            <stop offset="0" stop-color="#2a2219" />
            <stop offset="0.55" stop-color="#14110d" />
            <stop offset="1" stop-color="#090807" />
          </radialGradient>
          <radialGradient id={`${uid}-spot`} cx="0.5" cy="0.45" r="0.6">
            <stop offset="0" stop-color="#3a3026" />
            <stop offset="1" stop-color="#1a1612" />
          </radialGradient>
        </defs>
        <rect width="1000" height="800" fill={`url(#${uid}-bg)`} />
        <g class="art__window">
          <rect x="80" y="100" width="840" height="760" rx="14" fill="#12100d" stroke="#ffffff" stroke-opacity="0.08" />
          <text x="116" y="150" class="art__brand">morrow</text>
          {['Living', 'Dining', 'Lighting', 'Journal'].map((m, i) => (
            <text x={410 + i * 96} y="148" class="art__s">{m}</text>
          ))}
          <circle cx="872" cy="143" r="12" fill="none" stroke="#ebe7df" stroke-opacity="0.5" />
          <path d="M80 182H920" stroke="#ffffff" stroke-opacity="0.07" />

          <rect x="80" y="182" width="470" height="678" fill={`url(#${uid}-spot)`} />
          <ellipse cx="315" cy="612" rx="170" ry="16" fill="#000000" fill-opacity="0.45" />
          <g fill="none" stroke="#d8c3a2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M206 600 230 520M424 600 400 520M260 600l10-70M370 600l-10-70" stroke-opacity="0.7" />
          </g>
          <path d="M196 520c0-18 14-28 40-30l170-4c24 0 38 12 38 30 0 10-8 16-20 16H214c-12 0-18-6-18-12Z" fill="#cdb894" />
          <path d="M210 494c-8-60 0-130 26-176 18-30 54-44 92-42 44 2 74 22 86 60 14 46 10 104 0 156Z" fill="#d9c6a3" />
          <path d="M236 470c-2-50 6-104 28-136" fill="none" stroke="#ffffff" stroke-opacity="0.25" stroke-width="3" stroke-linecap="round" />
          <text x="110" y="828" class="art__s">01 / 06</text>

          <text x="596" y="262" class="art__s art__s--caps">Lounge · Oak & bouclé</text>
          <text x="596" y="318" class="art__serif">Lune lounge</text>
          <text x="596" y="364" class="art__serif">chair</text>
          <text x="596" y="414" class="art__kpi">€ 1,240</text>
          <text x="596" y="470" class="art__s">Upholstery</text>
          {['#d9c6a3', '#3a3530', '#8a4f36'].map((c, i) => (
            <circle cx={612 + i * 40} cy="502" r="13" fill={c} stroke={i === 0 ? '#ebe7df' : 'none'} stroke-width="2" stroke-opacity="0.8" />
          ))}
          <rect x="596" y="550" width="290" height="56" rx="28" fill="#ebe7df" />
          <text x="741" y="584" class="art__m art__m--ink" text-anchor="middle">Add to cart</text>
          <text x="596" y="648" class="art__s">Made to order · ships in 3 weeks</text>
          {[0, 1, 2].map((i) => (
            <g>
              <path d={`M596 ${690 + i * 46}H886`} stroke="#ffffff" stroke-opacity="0.08" />
              <rect x="596" y={706 + i * 46} width={[110, 140, 96][i]} height="8" rx="4" fill="#ebe7df" fill-opacity="0.3" />
              <path d={`m874 ${706 + i * 46} 6 4-6 4`} fill="none" stroke="#ebe7df" stroke-opacity="0.4" stroke-width="1.5" />
            </g>
          ))}
        </g>
      </>
    )
  }

  {
    variant === 'arcwell' && (
      <>
        <defs>
          <radialGradient id={`${uid}-bg`} cx="0.8" cy="0.9" r="1.1">
            <stop offset="0" stop-color="#18223a" />
            <stop offset="0.55" stop-color="#0d1220" />
            <stop offset="1" stop-color="#07080c" />
          </radialGradient>
          <pattern id={`${uid}-grid`} width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M40 0H0V40" fill="none" stroke="#ffffff" stroke-opacity="0.035" />
          </pattern>
        </defs>
        <rect width="1000" height="800" fill={`url(#${uid}-bg)`} />
        <rect width="1000" height="800" fill={`url(#${uid}-grid)`} />

        <g class="art__window">
          <rect x="70" y="90" width="610" height="452" rx="12" fill="#0b0f18" stroke="#ffffff" stroke-opacity="0.1" />
          <path d="M70 102a12 12 0 0 1 12-12h586a12 12 0 0 1 12 12v30H70Z" fill="#101624" />
          <circle cx="96" cy="111" r="5" fill="#ffffff" fill-opacity="0.18" />
          <circle cx="114" cy="111" r="5" fill="#ffffff" fill-opacity="0.18" />
          <circle cx="132" cy="111" r="5" fill="#ffffff" fill-opacity="0.18" />
          <text x="375" y="116" class="art__mono art__mono--dim" text-anchor="middle">~/arcwell/payments</text>
          <text x="100" y="180" class="art__mono">
            <tspan class="art__mono--accent">$</tspan> arc deploy payments --env production
          </text>
          {[
            ['build', '42s'],
            ['test', '318 passed'],
            ['security scan', '0 issues'],
            ['canary 5%', 'healthy · p99 182ms'],
          ].map(([k, v], i) => (
            <text x="100" y={226 + i * 40} class="art__mono">
              <tspan class="art__mono--ok">✓</tspan>
              <tspan dx="12">{k}</tspan>
              <tspan x="360" class="art__mono--dim">{v}</tspan>
            </text>
          ))}
          <text x="100" y="402" class="art__mono">
            <tspan class="art__mono--accent">→</tspan>
            <tspan dx="12">promoted to 100%</tspan>
          </text>
          <text x="100" y="448" class="art__mono art__mono--dim">done in 8m 51s</text>
          <rect x="100" y="476" width="10" height="20" fill="#9fb6d9" class="art__caret" />
        </g>

        <g class="art__graph">
          <rect x="430" y="470" width="540" height="270" rx="12" fill="#0b0f18" fill-opacity="0.92" stroke="#ffffff" stroke-opacity="0.1" />
          <text x="458" y="512" class="art__s">Pipeline · main</text>
          <text x="944" y="512" class="art__s art__s--accent" text-anchor="end">● live</text>
          <path d="M520 620H870" stroke="#9fb6d9" stroke-opacity="0.35" stroke-width="2" stroke-dasharray="2 6" />
          {['build', 'test', 'canary', 'prod'].map((n, i) => (
            <g>
              <rect x={466 + i * 120} y="592" width="96" height="56" rx="10" fill={i === 3 ? '#9fb6d9' : '#121a2a'} fill-opacity={i === 3 ? 0.16 : 1} stroke="#9fb6d9" stroke-opacity={i === 3 ? 0.6 : 0.25} />
              <text x={514 + i * 120} y="626" class="art__m" text-anchor="middle">{n}</text>
              <circle cx={556 + i * 120} cy="592" r="9" fill="#9fb6d9" />
              <path d={`m${551 + i * 120} 592 3.5 3.5 6-7`} fill="none" stroke="#0b0f18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </g>
          ))}
          <text x="458" y="704" class="art__s">Deploys this week</text>
          {[18, 26, 22, 34, 30, 42, 38].map((h, i) => (
            <rect x={760 + i * 26} y={714 - h} width="14" height={h} rx="3" fill="#9fb6d9" fill-opacity={0.25 + i * 0.08} />
          ))}
        </g>
      </>
    )
  }
</svg>

<style is:global>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--f-text);
  }
  .art__h {
    font-size: 22px;
    fill: #ebe7df;
    fill-opacity: 0.92;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .art__h--lg {
    font-size: 30px;
  }
  .art__s {
    font-size: 13px;
    fill: #ebe7df;
    fill-opacity: 0.5;
  }
  .art__s--ink {
    fill: #0d0b0f;
    fill-opacity: 0.9;
    font-weight: 600;
  }
  .art__s--accent {
    fill: #a9d6cc;
    fill-opacity: 0.9;
  }
  .art__s--caps {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11px;
  }
  .art__m {
    font-size: 15px;
    fill: #ebe7df;
    fill-opacity: 0.85;
    font-weight: 500;
  }
  .art__m--ink {
    fill: #12100d;
    fill-opacity: 1;
  }
  .art__kpi {
    font-size: 30px;
    fill: #ebe7df;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .art__kpi--lg {
    font-size: 44px;
  }
  .art__serif {
    font-family: var(--f-display);
    font-size: 46px;
    fill: #ebe7df;
    font-weight: 400;
  }
  .art__brand {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.05em;
    fill: #ebe7df;
  }
  .art__mono {
    font-family: var(--f-mono);
    font-size: 16px;
    fill: #dfe6f2;
    fill-opacity: 0.85;
  }
  .art__mono--dim {
    fill-opacity: 0.45;
  }
  .art__mono--ok {
    fill: #9fd1b4;
    fill-opacity: 1;
  }
  .art__mono--accent {
    fill: #9fb6d9;
    fill-opacity: 1;
  }
  .art__caret {
    animation: nl-caret 1.1s steps(1) infinite;
  }
  @keyframes nl-caret {
    50% {
      opacity: 0;
    }
  }
</style>
