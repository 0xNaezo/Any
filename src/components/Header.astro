---
import GhostMark from './GhostMark.astro';
import Button from './Button.astro';
import { site } from '../data/site';
import { withBase } from '../lib/utils';

const home = withBase('/');
const isHome = Astro.url.pathname === home || `${Astro.url.pathname}/` === home;
const anchor = (hash: string) => (isHome ? hash : `${home}${hash}`);
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="brand" href={home} aria-label={`${site.name} — home`} data-brand>
      <GhostMark size={26} class="brand__mark" />
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <span class="nav__hover" data-nav-hover aria-hidden="true"></span>
      {
        site.nav.map((item) => (
          <a class="nav__link" href={anchor(item.href)} data-nav-link={item.href.slice(1)}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <span class="availability">
        <span class:list={['dot', { 'is-amber': !site.availability.open }]} aria-hidden="true"></span>
        <span>{site.availability.short}</span>
      </span>
      <Button label="Start a project" href={anchor('#contact')} size="sm" class="header__cta" />
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label>Open menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
  <span class="header__progress" data-progress aria-hidden="true"></span>
</header>

<div class="menu" id="mobile-menu" data-menu inert>
  <div class="menu__backdrop" data-menu-close></div>
  <div class="container menu__inner">
    <nav class="menu__nav" aria-label="Mobile">
      {
        site.nav.map((item, i) => (
          <a class="menu__link" href={anchor(item.href)} data-menu-link>
            <span class="menu__index mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="menu__text">{item.label}</span>
          </a>
        ))
      }
    </nav>
    <div class="menu__foot" data-menu-foot>
      <Button label="Start a project" href={anchor('#contact')} class="menu__cta" data-menu-link />
      <div class="menu__contacts">
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="link" href={site.links.telegram.href} target="_blank" rel="noopener">{site.links.telegram.label}</a>
      </div>
      <p class="label menu__status">
        <span class:list={['dot', { 'is-amber': !site.availability.open }]} aria-hidden="true"></span>
        {site.availability.long}
      </p>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: var(--header-h);
    transition: transform 0.6s var(--ease-out);
  }

  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(10 10 12 / 0.72);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }

  :global(.is-scrolled) .header::before,
  .header:global(.is-scrolled)::before,
  :global(.menu-open) .header::before {
    opacity: 1;
  }

  .header:global(.is-hidden) {
    transform: translateY(-101%);
  }

  .header__inner {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  /* Brand */
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    border-radius: 8px;
  }
  .brand__name {
    font-size: 1.0625rem;
    font-weight: 550;
    letter-spacing: -0.025em;
  }
  .brand :global(.brand__mark) {
    transition: transform 0.6s var(--ease-out);
  }
  .brand:hover :global(.brand__mark) {
    transform: translateY(-2px) rotate(-4deg);
  }

  /* Desktop nav */
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
  }
  .nav__link {
    position: relative;
    z-index: 1;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--fg-3);
    transition: color var(--dur) var(--ease-out);
  }
  .nav__link:hover,
  .nav__link:global(.is-active) {
    color: var(--fg);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 1px;
    width: 3px;
    height: 3px;
    margin-left: -1.5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    transform: translateY(3px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .nav__link:global(.is-active)::after {
    opacity: 1;
    transform: none;
  }
  .nav__hover {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.5s var(--ease-out),
      width 0.5s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }

  /* Actions */
  .header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .availability {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    color: var(--fg-2);
    white-space: nowrap;
  }

  .header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, rgb(var(--accent-rgb) / 0.1), rgb(var(--accent-rgb) / 0.8));
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  /* Menu toggle */
  .menu-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border-radius: 999px;
    color: var(--fg);
  }
  .menu-toggle__bars {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 6px;
  }
  .menu-toggle__bars span {
    display: block;
    width: 22px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.5s var(--ease-out);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* Mobile menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    visibility: hidden;
    pointer-events: none;
  }
  :global(.menu-open) .menu {
    visibility: visible;
    pointer-events: auto;
  }
  .menu__backdrop {
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: 0;
  }
  .menu__inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(var(--header-h) + 4vh);
    padding-bottom: max(28px, env(safe-area-inset-bottom));
    overflow-y: auto;
  }
  .menu__nav {
    display: flex;
    flex-direction: column;
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .menu__index {
    font-size: 0.75rem;
    color: var(--fg-3);
  }
  .menu__text {
    display: block;
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .menu__foot {
    display: grid;
    gap: 24px;
    padding-top: 32px;
  }
  .menu__foot :global(.menu__cta) {
    justify-self: start;
  }
  .menu__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    color: var(--fg-2);
  }
  .menu__status {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  @media (max-width: 1100px) {
    .availability {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .header__inner {
      grid-template-columns: 1fr auto;
    }
    .nav {
      display: none;
    }
    .menu-toggle {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .header__actions :global(.header__cta) {
      display: none;
    }
  }

  @media (min-width: 961px) {
    .menu {
      display: none;
    }
  }
</style>
