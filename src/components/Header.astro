---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { site } from '../site.config';
import { getContent, localePath, localeLabels, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Page slug of the current page ('' for the landing page). */
  page?: string;
}
const { locale, page = '' } = Astro.props;
const t = getContent(locale);
const home = localePath(locale);
// Anchors point at the landing page from everywhere else.
const anchor = (hash: string) => (page === '' ? hash : `${home}${hash}`);
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a href={home} class="nav__logo" aria-label={t.a11y.home}>
      <Logo />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {
          t.nav.links.map((l) => (
            <li>
              <a href={anchor(l.href)} class="nav__link" data-nav-link={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__right">
      {
        site.availability.open && (
          <span class="nav__avail">
            <span class="pulse" aria-hidden="true" />
            {t.nav.availability}
          </span>
        )
      }
      <div class="nav__lang" role="group" aria-label={t.a11y.language}>
        {
          locales.map((l) => (
            <a
              href={localePath(l, page)}
              hreflang={getContent(l).htmlLang}
              lang={getContent(l).htmlLang}
              aria-current={l === locale ? 'true' : undefined}
              data-locale={l}
              title={localeLabels[l].name}
            >
              {localeLabels[l].short}
            </a>
          ))
        }
      </div>
      <Button href={anchor('#contact')} size="sm" class="nav__cta">{t.nav.cta}</Button>
      <button class="nav__burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle data-label-open={t.a11y.menuOpen} data-label-close={t.a11y.menuClose}>
        <span class="visually-hidden" data-menu-label>{t.a11y.menuOpen}</span>
        <span class="nav__burger-line" aria-hidden="true"></span>
        <span class="nav__burger-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu aria-hidden="true" inert>
  <div class="menu__inner container">
    <nav aria-label="Mobile">
      <ol class="menu__links">
        {
          t.nav.links.map((l, i) => (
            <li class="menu__item" style={`--i:${i}`}>
              <a href={anchor(l.href)} class="menu__link" data-menu-link>
                <span class="label">{String(i + 1).padStart(2, '0')}</span>
                <span class="menu__text">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="menu__foot" style={`--i:${t.nav.links.length}`}>
      <Button href={anchor('#contact')} class="menu__cta" data-menu-link>{t.nav.cta}</Button>
      <div class="menu__meta">
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="nav__lang" role="group" aria-label={t.a11y.language}>
          {
            locales.map((l) => (
              <a href={localePath(l, page)} hreflang={getContent(l).htmlLang} lang={getContent(l).htmlLang} aria-current={l === locale ? 'true' : undefined} data-locale={l}>
                {localeLabels[l].short}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 90;
    height: var(--nav-h);
    transition:
      transform 0.7s var(--ease-out),
      background-color 0.6s var(--ease-out),
      border-color 0.6s var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(8 9 12 / 0.86);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  :global(.nav.is-scrolled) {
    border-bottom-color: var(--line);
  }

  :global(.nav.is-scrolled)::before,
  :global(.no-js) .nav::before {
    opacity: 1;
  }

  :global(.nav.is-hidden) {
    transform: translateY(-100%);
  }

  :global(.menu-open) .nav {
    transform: none;
    border-bottom-color: transparent;
  }

  :global(.menu-open) .nav::before {
    opacity: 0;
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__logo {
    flex: none;
    padding: 0.5rem 0;
  }

  .nav__links {
    margin-inline: auto;
  }

  .nav__links ul {
    display: flex;
    gap: clamp(1.25rem, 0.5rem + 1.6vw, 2.5rem);
  }

  .nav__link {
    position: relative;
    font-size: 0.875rem;
    color: var(--bone-2);
    transition: color 0.4s;
    padding: 0.5rem 0;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--gold);
    transform: translateX(-50%) scale(0);
    transition: transform 0.5s var(--ease-out);
  }

  .nav__link:hover,
  :global(.nav__link.is-active) {
    color: var(--bone);
  }

  :global(.nav__link.is-active)::after {
    transform: translateX(-50%) scale(1);
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: none;
  }

  .nav__avail {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bone-3);
    white-space: nowrap;
  }

  .pulse {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    opacity: 0;
    animation: nl-pulse 3.2s var(--ease-out) infinite;
  }

  @keyframes nl-pulse {
    0% {
      transform: scale(0.4);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .nav__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
  }

  .nav__lang a {
    padding: 0.4rem 0.35rem;
    color: var(--bone-3);
    transition: color 0.3s;
  }

  .nav__lang a + a::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--bone-4);
  }

  .nav__lang a:hover,
  .nav__lang a[aria-current] {
    color: var(--bone);
  }

  .nav__burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }

  .nav__burger-line {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1px;
    background: var(--bone);
    transition: transform 0.6s var(--ease-out);
  }

  .nav__burger-line:nth-of-type(2) {
    transform: translateY(-3.5px);
  }

  .nav__burger-line:nth-of-type(3) {
    transform: translateY(3.5px);
  }

  :global(.menu-open) .nav__burger-line:nth-of-type(2) {
    transform: rotate(45deg);
  }

  :global(.menu-open) .nav__burger-line:nth-of-type(3) {
    transform: rotate(-45deg);
  }

  @media (max-width: 1180px) {
    .nav__avail {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .nav__links,
    .nav__right > .nav__lang {
      display: none;
    }
    .nav__right {
      margin-left: auto;
    }
    .nav__burger {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .nav__right :global(.nav__cta) {
      display: none;
    }
  }

  /* ---------- mobile menu ---------- */

  .menu {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: var(--ink-1);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-in-out);
    overflow-y: auto;
  }

  :global(.menu-open) .menu {
    clip-path: inset(0 0 0 0);
  }

  .menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding-top: calc(var(--nav-h) + 4vh);
    padding-bottom: 2rem;
  }

  .menu__links {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .menu__item,
  .menu__foot {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.9s var(--ease-out);
    transition-delay: 0s;
  }

  :global(.menu-open) .menu__item,
  :global(.menu-open) .menu__foot {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.25s + var(--i) * 0.06s);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .menu__text {
    font-family: var(--f-display);
    font-size: clamp(2.25rem, 8vw, 3.5rem);
    font-weight: 300;
    line-height: 1;
  }

  .menu__foot {
    display: grid;
    gap: 1.75rem;
  }

  .menu__foot :global(.menu__cta) {
    justify-self: start;
  }

  .menu__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--bone-2);
    font-size: var(--fs-s);
  }

  @media (min-width: 961px) {
    .menu {
      display: none;
    }
  }
</style>
