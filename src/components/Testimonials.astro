---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { initials } from '../lib/utils';

const { testimonials, clients } = site;
const { featured } = testimonials;
---

<section class="section testimonials" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="t__bar">
      <span class="t__line" data-line aria-hidden="true"></span>
      <h2 id="testimonials-title" class="label t__label" data-scramble>{testimonials.label}</h2>
      <p class="label t__meta">
        <Icon name="star" size={11} class="t__star" />
        {clients.rating.score} / 5 · {clients.rating.count}
      </p>
    </div>

    <figure class="t__featured">
      <blockquote class="t__quote" data-scrub-words>
        <p><span class="t__mark" aria-hidden="true">“</span>{featured.quote}<span aria-hidden="true">”</span></p>
      </blockquote>
      <figcaption class="t__author" data-reveal>
        <span class="t__avatar" aria-hidden="true">{initials(featured.name)}</span>
        <span class="t__who">
          <span class="t__name">{featured.name}</span>
          <span class="t__role">{featured.role}, {featured.company}</span>
        </span>
      </figcaption>
    </figure>

    <ul class="t__list" data-stagger>
      {
        testimonials.items.map((item) => (
          <li data-stagger-item>
            <figure class="t__item">
              <blockquote>
                <p>“{item.quote}”</p>
              </blockquote>
              <figcaption class="t__author t__author--small">
                <span class="t__avatar t__avatar--small" aria-hidden="true">
                  {initials(item.name)}
                </span>
                <span class="t__who">
                  <span class="t__name">{item.name}</span>
                  <span class="t__role">
                    {item.role}, {item.company}
                  </span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .t__bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 18px;
  }
  .t__bar > * {
    white-space: nowrap;
  }
  .t__line {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--line-2);
    transform-origin: left center;
  }
  .t__label {
    color: var(--fg-2);
  }
  .t__meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .t__meta :global(.t__star) {
    color: var(--accent);
  }

  .t__featured {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    margin-top: clamp(56px, 7vw, 104px);
  }
  .t__quote {
    grid-column: 3 / -1;
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 1rem + 2.7vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: -0.012em;
    color: var(--fg);
    text-wrap: pretty;
  }
  .t__mark {
    display: inline-block;
    margin-left: -0.42em;
    width: 0.42em;
    color: var(--fg-3);
  }
  .t__featured .t__author {
    grid-column: 3 / -1;
  }

  .t__author {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .t__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--bg-3);
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--fg);
  }
  .t__avatar--small {
    width: 36px;
    height: 36px;
    font-size: 0.9375rem;
  }
  .t__who {
    display: grid;
    gap: 2px;
    line-height: 1.3;
  }
  .t__name {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg);
  }
  .t__role {
    font-size: 0.875rem;
    color: var(--fg-3);
  }

  .t__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 48px;
    margin-top: clamp(80px, 9vw, 136px);
  }
  .t__item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    height: 100%;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .t__item blockquote {
    font-size: 1.0625rem;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  @media (max-width: 1023px) {
    .t__quote,
    .t__featured .t__author {
      grid-column: 1 / -1;
    }
    .t__mark {
      margin-left: 0;
      width: auto;
    }
    .t__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
