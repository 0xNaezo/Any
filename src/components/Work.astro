---
import SectionHead from './SectionHead.astro';
import WorkVisual from './WorkVisual.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { withBase } from '../lib/utils';

const { work } = site;
const total = String(work.cases.length).padStart(2, '0');
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container">
    <SectionHead
      index={work.index}
      label={work.label}
      meta={work.meta}
      title={work.title}
      lead={work.lead}
      titleId="work-title"
    />

    <div class="cases" data-cases>
      {
        work.cases.map((item, i) => (
          <article class="case" data-case style={`--i: ${i}`} aria-labelledby={`case-${i}`}>
            <div class="case__card">
              <div class="case__media" data-spotlight>
                <div class="case__frame">
                  <div class="case__parallax" data-parallax>
                    {item.image ? (
                      <img
                        class="case__img"
                        src={withBase(item.image)}
                        alt={`${item.client} — ${item.title}`}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <WorkVisual kind={item.visual} label={`${item.client} product interface`} />
                    )}
                  </div>
                </div>
              </div>

              <div class="case__body">
                <div class="case__top">
                  <span class="label case__count">
                    {String(i + 1).padStart(2, '0')}
                    <span class="case__total">/ {total}</span>
                  </span>
                  <span class="case__live">
                    <span class="dot" aria-hidden="true" />
                    {item.status ?? 'In production'}
                  </span>
                </div>

                <div class="case__main">
                  <p class="label case__meta">
                    {item.year} · {item.industry}
                  </p>
                  <h3 class="case__client" id={`case-${i}`}>
                    {item.href ? (
                      <a href={item.href} target="_blank" rel="noopener" class="case__link">
                        {item.client}
                        <Icon name="arrow-up-right" size={22} />
                      </a>
                    ) : (
                      item.client
                    )}
                  </h3>
                  <p class="case__title">{item.title}</p>
                  <p class="case__summary">{item.summary}</p>
                </div>

                <dl class="case__metrics">
                  {item.metrics.map((metric) => (
                    <div class="case__metric">
                      <dt class="case__metric-label">{metric.label}</dt>
                      <dd class="case__metric-value">{metric.value}</dd>
                    </div>
                  ))}
                </dl>

                <div class="case__foot">
                  <ul class="case__tags" aria-label="Scope">
                    {item.services.map((service) => (
                      <li class="tag">{service}</li>
                    ))}
                  </ul>
                  <p class="case__stack mono">
                    <span class="sr-only">Stack: </span>
                    {item.stack.join(' · ')}
                  </p>
                </div>
              </div>
              <span class="case__shade" aria-hidden="true" />
            </div>
          </article>
        ))
      }
    </div>

    <div class="work__foot" data-reveal>
      <p>
        <span class="work__foot-mark" aria-hidden="true"></span>
        {work.more}
      </p>
      <a class="link work__foot-link" href="#contact">{work.moreCta}</a>
    </div>
  </div>
</section>

<style>
  .cases {
    --peek: 14px;
    display: grid;
    gap: clamp(56px, 7vw, 96px);
    margin-top: clamp(64px, 8vw, 112px);
  }

  .case__card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: 28px;
    background: linear-gradient(180deg, #121216 0%, #0d0d10 100%);
    box-shadow:
      inset 0 0 0 1px var(--line),
      inset 0 1px 0 rgb(255 255 255 / 0.05);
    transform-origin: 50% 0%;
  }

  /* ── media ── */
  .case__media {
    --mx: 50%;
    --my: 30%;
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 10px 10px 0;
    overflow: hidden;
    border-radius: 20px;
    background:
      radial-gradient(60% 55% at var(--mx) var(--my), rgb(255 255 255 / 0.06), transparent 70%),
      linear-gradient(180deg, #15151a, #0e0e11);
    box-shadow: inset 0 0 0 1px var(--line);
    isolation: isolate;
  }
  .case__media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
    mask-image: radial-gradient(80% 70% at 50% 45%, #000, transparent);
  }
  .case__frame {
    position: absolute;
    inset: 4% 3%;
    display: grid;
    place-items: center;
    transition: transform 1.1s var(--ease-out);
  }
  .case__parallax {
    width: 100%;
  }
  .case__frame :global(.visual),
  .case__img {
    display: block;
    width: 100%;
    height: auto;
  }
  .case__img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top center;
    border-radius: 12px;
  }
  .case:hover .case__frame {
    transform: translateY(-1%) scale(1.02);
  }

  /* ── body ── */
  .case__body {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: clamp(24px, 3vw, 44px);
  }
  .case__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .case__count {
    color: var(--fg);
  }
  .case__total {
    color: var(--fg-3);
  }
  .case__live {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px 7px 11px;
    border-radius: 999px;
    background: rgb(var(--accent-rgb) / 0.06);
    box-shadow: inset 0 0 0 1px rgb(var(--accent-rgb) / 0.16);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .case__live :global(.dot) {
    width: 6px;
    height: 6px;
  }

  .case__main {
    display: grid;
    gap: 14px;
  }
  .case__meta {
    color: var(--fg-3);
  }
  .case__client {
    font-size: clamp(2.25rem, 1.4rem + 2.2vw, 3.75rem);
    font-weight: 450;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .case__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .case__link :global(svg) {
    color: var(--fg-3);
    transition:
      transform var(--dur) var(--ease-out),
      color var(--dur);
  }
  .case__link:hover :global(svg) {
    color: var(--fg);
    transform: translate(3px, -3px);
  }
  .case__title {
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--fg);
    max-width: 30ch;
  }
  .case__summary {
    max-width: 52ch;
    font-size: 0.9375rem;
  }

  .case__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    padding-block: 20px;
    border-block: 1px solid var(--line);
  }
  .case__metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
  }
  .case__metric-value {
    font-size: clamp(1.625rem, 1.1rem + 1.2vw, 2.375rem);
    font-weight: 450;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .case__metric-label {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--fg-3);
  }

  .case__foot {
    display: grid;
    gap: 14px;
  }
  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .case__stack {
    font-size: 0.75rem;
    color: var(--fg-3);
    letter-spacing: 0.02em;
  }

  /* darkens a card as the next one slides over it */
  .case__shade {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #050506;
    opacity: 0;
    pointer-events: none;
  }

  /* ── desktop: a deck of cards that stack as you scroll ── */
  @media (min-width: 1024px) {
    .cases {
      gap: 0;
    }
    .case {
      position: sticky;
      top: calc(var(--header-h) + 20px + var(--i) * var(--peek));
      padding-bottom: clamp(40px, 6vh, 72px);
    }
    .case:last-child {
      padding-bottom: 0;
    }
    .case__card {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      height: min(calc(100svh - var(--header-h) - 40px - 3 * var(--peek)), 760px);
      min-height: 560px;
      box-shadow:
        inset 0 0 0 1px var(--line),
        inset 0 1px 0 rgb(255 255 255 / 0.05),
        0 -30px 60px -20px rgb(0 0 0 / 0.7);
    }
    .case__media {
      aspect-ratio: auto;
      margin: 12px 0 12px 12px;
    }
    /* the product rises from the bottom edge of the panel */
    .case__frame {
      inset: 9% 5% auto;
      display: block;
    }
    .case__parallax {
      scale: 1.14;
      transform-origin: 50% 0%;
    }
    .case__body {
      justify-content: space-between;
      gap: 24px;
      padding: clamp(32px, 3vw, 48px);
    }
    .case__main {
      margin-block: auto;
    }
  }

  .work__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: clamp(72px, 8vw, 120px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .work__foot p {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--fg-2);
  }
  .work__foot-mark {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--fg-4);
  }
  .work__foot-link {
    color: var(--fg);
    font-weight: 500;
    background-size: 100% 1px;
  }
  .work__foot-link:hover {
    background-size: 0 1px;
    background-position: 100% 100%;
  }

  @media (max-width: 639px) {
    .case__card {
      border-radius: 22px;
    }
    .case__media {
      margin: 8px 8px 0;
      border-radius: 16px;
    }
    .case__metrics {
      gap: 12px;
    }
    .case__metric-label {
      font-size: 0.75rem;
    }
  }
</style>
