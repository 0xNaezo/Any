---
import SectionHead from './SectionHead.astro';
import { site } from '../data/site';

const { process } = site;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section process" id="process" aria-labelledby="process-title">
  <div class="container">
    <SectionHead
      index={process.index}
      label={process.label}
      meta={process.meta}
      title={process.title}
      lead={process.lead}
      titleId="process-title"
    />

    <div class="process__layout" data-process>
      <aside class="process__aside" aria-hidden="true">
        <div class="process__sticky">
          <p class="label">Step</p>
          <p class="process__counter">
            <span class="process__num" data-step-num>01</span><span class="process__of">/{pad(process.steps.length)}</span>
          </p>
          <p class="process__name" data-step-name>{process.steps[0].title}</p>
          <span class="process__bar"><span data-step-bar></span></span>
        </div>
      </aside>

      <ol class="steps">
        <span class="steps__rail" aria-hidden="true"><span class="steps__fill" data-steps-fill></span></span>
        {
          process.steps.map((step, i) => (
            <li class="step" data-step data-step-title={step.title}>
              <span class="step__node" aria-hidden="true" />
              <p class="step__meta label">
                <span class="step__num">{pad(i + 1)}</span>
                <span class="step__sep" aria-hidden="true" />
                <span>{step.duration}</span>
              </p>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
              <p class="step__output">
                <span class="label">Output</span>
                <span>{step.output}</span>
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process__layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    margin-top: clamp(64px, 8vw, 120px);
  }

  .process__aside {
    grid-column: 1 / span 4;
  }
  .process__sticky {
    position: sticky;
    top: calc(var(--header-h) + 48px);
    display: grid;
    gap: 14px;
    max-width: 300px;
  }
  .process__counter {
    display: flex;
    align-items: baseline;
    font-size: clamp(5rem, 3rem + 5vw, 8.5rem);
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .process__of {
    margin-left: 0.08em;
    font-size: 0.28em;
    letter-spacing: -0.02em;
    color: var(--fg-4);
  }
  .process__name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--fg-2);
  }
  .process__bar {
    position: relative;
    display: block;
    height: 1px;
    margin-top: 10px;
    background: var(--line-2);
    overflow: hidden;
  }
  .process__bar span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0.1667);
    transform-origin: left center;
    transition: transform 0.8s var(--ease-out);
  }

  .steps {
    position: relative;
    grid-column: 6 / -1;
  }
  .steps__rail {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 5px;
    width: 1px;
    background: var(--line-2);
  }
  .steps__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(var(--accent-rgb) / 0.2), var(--accent));
    transform: scaleY(0);
    transform-origin: top center;
  }

  .step {
    position: relative;
    display: grid;
    gap: 14px;
    padding-left: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  .step:last-child {
    padding-bottom: 0;
  }

  .step__node {
    position: absolute;
    top: 3px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line-3);
    transition:
      background-color 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }
  .step:global(.is-active) .step__node {
    background: var(--accent);
    box-shadow:
      inset 0 0 0 1px var(--accent),
      0 0 0 5px rgb(var(--accent-rgb) / 0.12);
  }

  .step__meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .step__num {
    color: var(--fg-2);
  }
  .step__sep {
    width: 20px;
    height: 1px;
    background: var(--line-3);
  }
  .step__title {
    font-size: clamp(1.75rem, 1.3rem + 1.3vw, 2.75rem);
    font-weight: 450;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--fg-3);
    transition: color 0.6s var(--ease-out);
  }
  .step:global(.is-active) .step__title,
  :global(html:not(.js)) .step__title {
    color: var(--fg);
  }
  .step__text {
    max-width: 52ch;
  }
  .step__output {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
    margin-top: 6px;
    padding: 8px 14px 8px 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.875rem;
    color: var(--fg);
  }
  .step__output .label {
    color: var(--fg-3);
  }

  @media (max-width: 1023px) {
    .process__aside {
      display: none;
    }
    .steps {
      grid-column: 1 / -1;
    }
  }
</style>
