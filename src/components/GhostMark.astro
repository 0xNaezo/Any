---
/**
 * The Nightloom ghost — woven from seven threads.
 * `woven` is the primary mark; `solid` is used where the threads would be lost (favicons, tiny sizes).
 */
interface Props {
  variant?: 'woven' | 'solid';
  size?: number | string;
  class?: string;
  title?: string;
}

const { variant = 'woven', size = 28, class: className, title } = Astro.props;

const paths = {
  woven: 'M16 4A10 10 0 0 1 23.056 6.914H8.944A10 10 0 0 1 16 4ZM8.388 7.514H23.612A10 10 0 0 1 25.34 10.429H6.66A10 10 0 0 1 8.388 7.514ZM6.452 11.029H25.548A10 10 0 0 1 26 13.943H6A10 10 0 0 1 6.452 11.029ZM6 14.543H26V17.457H6V14.543ZM6 18.057H26V20.971H6V18.057ZM6 21.571H26V24.486H6V21.571ZM6 25.086H26V26.8C25.351 27.412 24.726 28 24 28 C22.543 28 21.457 25.6 20 25.6 C18.543 25.6 17.457 28 16 28 C14.543 28 13.457 25.6 12 25.6 C10.543 25.6 9.457 28 8 28 C7.274 28 6.649 27.412 6 26.8V25.086ZM10.863 13.943A1.55 2.35 0 0 1 13.937 13.943ZM13.937 14.543A1.55 2.35 0 0 1 10.863 14.543ZM18.063 13.943A1.55 2.35 0 0 1 21.137 13.943ZM21.137 14.543A1.55 2.35 0 0 1 18.063 14.543Z',
  solid: 'M6 14A10 10 0 0 1 26 14V26.8C25.351 27.412 24.726 28 24 28 C22.543 28 21.457 25.6 20 25.6 C18.543 25.6 17.457 28 16 28 C14.543 28 13.457 25.6 12 25.6 C10.543 25.6 9.457 28 8 28 C7.274 28 6.649 27.412 6 26.8ZM10.85 14.243a1.55 2.35 0 1 0 3.1 0a1.55 2.35 0 1 0 -3.1 0ZM18.05 14.243a1.55 2.35 0 1 0 3.1 0a1.55 2.35 0 1 0 -3.1 0Z',
};
---

<svg
  class:list={['ghost-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="currentColor"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <path fill-rule="evenodd" d={paths[variant]} />
</svg>
