---
interface Props {
  url: string;
}
const { url } = Astro.props;
---

<div class="mb">
  <div class="mb__bar">
    <span class="mb__dots"><i></i><i></i><i></i></span>
    <span class="mb__url"><span class="mb__lock"></span>{url}</span>
    <span class="mb__spacer"></span>
  </div>
  <div class="mb__body">
    <slot />
  </div>
</div>

<style>
  .mb {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: #0e0e11;
    border: 1px solid rgb(255 255 255 / 0.1);
    overflow: hidden;
  }

  .mb__bar {
    display: flex;
    align-items: center;
    gap: 1.4em;
    height: 3.4em;
    padding: 0 1.4em;
    border-bottom: 1px solid rgb(255 255 255 / 0.07);
    background: #111115;
    flex-shrink: 0;
  }

  .mb__dots {
    display: flex;
    gap: 0.55em;
  }

  .mb__dots i {
    width: 0.75em;
    height: 0.75em;
    background: rgb(255 255 255 / 0.16);
  }

  .mb__url {
    display: flex;
    align-items: center;
    gap: 0.7em;
    margin-inline: auto;
    padding: 0.45em 1.4em;
    min-width: 40%;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.95em;
    color: rgb(255 255 255 / 0.45);
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.06);
  }

  .mb__lock {
    width: 0.6em;
    height: 0.7em;
    background: var(--accent);
    opacity: 0.8;
  }

  .mb__spacer {
    width: 3.3em;
  }

  .mb__body {
    position: relative;
    flex: 1;
    min-height: 0;
  }
</style>
