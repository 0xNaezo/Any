---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import SeniorRoster from '../bento/SeniorRoster.astro';
import ChatFeed from '../bento/ChatFeed.astro';
import GitGraph from '../bento/GitGraph.astro';
import BudgetTracker from '../bento/BudgetTracker.astro';
import Pipeline from '../bento/Pipeline.astro';
import TimezoneChart from '../bento/TimezoneChart.astro';
import { why } from '../../content/site';
---

<section class="section why" id="why" aria-labelledby="why-title">
  <div class="container">
    <SectionHeader index="03" eyebrow={why.eyebrow} title={why.title} lead={why.lead} layout="split" headingId="why-title" />

    <div class="bento" data-reveal-stagger>
      <article class="card bento-card bento-senior" data-spotlight>
        <span class="spotlight-fill" aria-hidden="true"></span>
        <div class="bento-copy">
          <span class="icon-tile"><Icon name="shield" /></span>
          <h3 class="h-card">{why.senior.title}</h3>
          <p>{why.senior.text}</p>
        </div>
        <SeniorRoster roster={why.senior.roster} />
      </article>

      <article class="card bento-card bento-comms" data-spotlight>
        <span class="spotlight-fill" aria-hidden="true"></span>
        <div class="bento-copy">
          <span class="icon-tile"><Icon name="chat" /></span>
          <h3 class="h-card">{why.comms.title}</h3>
          <p>{why.comms.text}</p>
        </div>
        <div class="bento-visual bento-visual--grow">
          <ChatFeed channel={why.comms.channel} messages={why.comms.messages} />
        </div>
      </article>

      <article class="card bento-card bento-own" data-spotlight>
        <span class="spotlight-fill" aria-hidden="true"></span>
        <div class="bento-copy">
          <h3 class="h-card">{why.ownership.title}</h3>
          <p>{why.ownership.text}</p>
        </div>
        <div class="bento-visual">
          <GitGraph repo={why.ownership.repo} />
        </div>
      </article>

      <article class="card bento-card bento-budget" data-spotlight>
        <span class="spotlight-fill" aria-hidden="true"></span>
        <div class="bento-copy">
          <h3 class="h-card">{why.budget.title}</h3>
          <p>{why.budget.text}</p>
        </div>
        <div class="bento-visual">
          <BudgetTracker milestone={why.budget.milestone} spent={why.budget.spent} total={why.budget.total} />
        </div>
      </article>

      <article class="card bento-card bento-quality" data-spotlight>
        <span class="spotlight-fill" aria-hidden="true"></span>
        <div class="bento-copy">
          <h3 class="h-card">{why.quality.title}</h3>
          <p>{why.quality.text}</p>
        </div>
        <div class="bento-visual">
          <Pipeline checks={why.quality.checks} />
        </div>
      </article>

      <article class="card bento-card bento-tz" data-spotlight>
        <span class="spotlight-fill" aria-hidden="true"></span>
        <div class="bento-copy">
          <span class="icon-tile"><Icon name="globe" /></span>
          <h3 class="h-card">{why.timezone.title}</h3>
          <p>{why.timezone.text}</p>
        </div>
        <TimezoneChart zones={why.timezone.zones} />
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'senior senior comms'
      'own budget comms'
      'quality tz tz';
    gap: 1rem;
  }

  .bento-card {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    padding: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    min-width: 0;
  }

  .bento-copy {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .bento-copy .icon-tile {
    margin-bottom: 0.5rem;
  }

  .bento-copy p {
    color: var(--text-2);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 30rem;
  }

  .bento-visual {
    margin-top: auto;
  }

  .bento-visual--grow {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .bento-senior {
    grid-area: senior;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 2rem;
  }

  .bento-comms {
    grid-area: comms;
  }

  .bento-own {
    grid-area: own;
  }

  .bento-budget {
    grid-area: budget;
  }

  .bento-quality {
    grid-area: quality;
  }

  .bento-tz {
    grid-area: tz;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: 2rem;
  }

  @media (max-width: 1100px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'senior senior'
        'comms own'
        'comms budget'
        'quality quality'
        'tz tz';
    }
  }

  @media (max-width: 760px) {
    .bento {
      grid-template-columns: 1fr;
      grid-template-areas: 'senior' 'comms' 'own' 'budget' 'quality' 'tz';
    }

    .bento-senior,
    .bento-tz {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
  }
</style>
