---
import ClientLogo from '../ui/ClientLogo.astro';
import { clients } from '../../content/site';
---

<section class="clients" aria-label="Clients">
  <div class="container">
    <p class="clients-label" data-reveal>{clients.label}</p>
  </div>
  <div class="marquee clients-marquee" data-reveal>
    {
      [0, 1].map((copy) => (
        <ul class="marquee-track" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {clients.logos.map((logo) => (
            <li>
              <ClientLogo {...logo} />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .clients {
    position: relative;
    padding-block: clamp(3.5rem, 3rem + 2vw, 5rem) clamp(1rem, 2vw, 2rem);
  }

  .clients-label {
    margin-bottom: 2rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-3);
  }

  .clients-marquee {
    --gap: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    --duration: 46s;
  }

  .marquee-track {
    list-style: none;
    margin: 0;
    padding-left: 0;
  }
</style>
