---
import { clients } from '../../data/site';

/*
 * Placeholder wordmarks for fictional clients. Each gets a tiny geometric glyph and its
 * own type treatment so the row reads like a set of real logos. Replace with real SVGs.
 */
const marks: Record<string, { glyph: string; style: string }> = {
  Ledgerline: {
    glyph: '<path d="M3 6h14M3 10h14M3 14h9"/>',
    style: 'sans-bold',
  },
  'Harbor Health': {
    glyph: '<path d="M3 13a7 7 0 0 1 14 0"/><path d="M10 6v4M8 8h4"/>',
    style: 'serif',
  },
  Fieldnote: {
    glyph: '<rect x="4" y="3.5" width="12" height="13" rx="1"/><path d="M7 8h6M7 11h4"/>',
    style: 'sans',
  },
  Orbital: {
    glyph: '<circle cx="10" cy="10" r="2.5"/><ellipse cx="10" cy="10" rx="7.5" ry="4" transform="rotate(-25 10 10)"/>',
    style: 'mono',
  },
  'Atelier Nord': {
    glyph: '<path d="M4 16L10 4l6 12M6.5 11.5h7"/>',
    style: 'serif-italic',
  },
  'Kestrel Labs': {
    glyph: '<path d="M3 12l7-6 7 6M6 15l4-3.5 4 3.5"/>',
    style: 'sans-wide',
  },
};
---

<section class="clients" aria-label="Selected clients">
  <div class="container">
    <div class="clients-inner">
      <p class="label clients-label" data-reveal="fade">Trusted by teams at</p>
      <ul class="clients-list">
        {
          clients.map((name) => {
            const m = marks[name] ?? { glyph: '<circle cx="10" cy="10" r="6"/>', style: 'sans' };
            return (
              <li class:list={['client', `client--${m.style}`]} data-reveal="fade">
                <svg
                  viewBox="0 0 20 20"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={m.glyph}
                />
                <span>{name}</span>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .clients {
    position: relative;
    z-index: 1;
  }
  .clients-inner {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) 4fr;
    align-items: center;
    gap: 2rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: 1.75rem;
  }
  .clients-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem 2.5rem;
  }
  .client {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink-3);
    transition: color var(--dur) linear;
    white-space: nowrap;
  }
  .client:hover {
    color: var(--ink);
  }
  .client--sans-bold span {
    font-weight: 600;
    letter-spacing: -0.03em;
    font-size: 1.125rem;
  }
  .client--serif span {
    font-family: var(--serif);
    font-size: 1.3rem;
    letter-spacing: -0.01em;
  }
  .client--sans span {
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .client--mono span {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .client--serif-italic span {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
  }
  .client--sans-wide span {
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .clients-inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .clients-list {
      justify-content: flex-start;
      gap: 1.25rem 2rem;
    }
  }
</style>
