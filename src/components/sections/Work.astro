---
import { getCollection } from 'astro:content';
import SectionHead from '../ui/SectionHead.astro';
import Cover from '../visuals/Cover.astro';
import Icon from '../ui/Icon.astro';
import { work } from '../../data/site';

const cases = (await getCollection('work', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container">
    <SectionHead id="work-title" index={work.index} label={work.label} title={work.title} lede={work.lede} />

    <ul class="cases">
      {
        cases.map((c, i) => (
          <li class="case-item" data-reveal>
            <a class="case" href={`/work/${c.id}/`}>
              <div class="case-visual">
                <Cover name={c.data.cover} image={c.data.image} alt={`${c.data.client} — ${c.data.headline}`} />
                <span class="case-cta label label--ink">
                  Read the case <Icon name="arrow-up-right" size={12} />
                </span>
              </div>
              <div class="case-meta">
                <span class="label label--ink">{pad(i + 1)}</span>
                <span class="label">
                  {c.data.sector} · {c.data.year}
                </span>
              </div>
              <h3 class="case-title display">{c.data.client}</h3>
              <p class="case-headline">{c.data.headline}</p>
              <dl class="case-results">
                {c.data.results.map((r) => (
                  <div>
                    <dt class="label">{r.label}</dt>
                    <dd class="display">{r.value}</dd>
                  </div>
                ))}
              </dl>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="archive">
      <div class="archive-head grid">
        <p class="label archive-label" data-reveal="fade">Index — more projects</p>
        <p class="archive-note muted" data-reveal="fade">
          Plus a long tail of work under NDA. Happy to walk you through anything relevant on a call.
        </p>
      </div>
      <table class="archive-table" data-reveal>
        <caption class="visually-hidden">Other projects</caption>
        <thead>
          <tr>
            <th scope="col" class="label">Year</th>
            <th scope="col" class="label">Client</th>
            <th scope="col" class="label">Project</th>
            <th scope="col" class="label col-type">Type</th>
            <th scope="col" class="label col-stack">Stack</th>
          </tr>
        </thead>
        <tbody>
          {
            work.archive.map((row) => (
              <tr>
                <td class="mono dim tabular">{row.year}</td>
                <td class="col-client">{row.client}</td>
                <td class="muted">{row.project}</td>
                <td class="mono dim col-type">{row.type}</td>
                <td class="mono dim col-stack">{row.stack}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .cases {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: clamp(4rem, 3rem + 4vw, 7rem);
  }
  /* Editorial stagger: the right column sits lower. */
  .case-item:nth-child(even) {
    margin-top: clamp(4rem, 2rem + 8vw, 10rem);
  }
  .case-item:nth-child(even) + .case-item:nth-child(odd) {
    margin-top: 0;
  }

  .case {
    display: block;
  }
  .case-visual {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
  }
  .case-visual :global(.cover) {
    transition:
      transform 1.1s var(--ease-out),
      filter 1.1s var(--ease-out);
    filter: brightness(0.92);
  }
  .case:hover .case-visual :global(.cover) {
    transform: scale(1.025);
    filter: brightness(1.08);
  }
  .case-cta {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2rem;
    padding-inline: 0.85rem;
    border-radius: var(--radius);
    background: rgb(11 11 12 / 0.75);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line-2);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }
  .case:hover .case-cta,
  .case:focus-visible .case-cta {
    opacity: 1;
    transform: none;
  }

  .case-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .case-title {
    margin-top: 1.25rem;
    font-size: var(--display-sm);
    line-height: 1.04;
    letter-spacing: -0.024em;
  }
  .case-headline {
    margin-top: 0.4rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--display-xs);
    line-height: 1.2;
    color: var(--ink-2);
  }
  .case-results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .case-results div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.45rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .case-results dd {
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.625rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  /* Archive */
  .archive {
    margin-top: clamp(6rem, 4rem + 6vw, 10rem);
  }
  .archive-head {
    row-gap: 0.75rem;
    margin-bottom: 1.5rem;
    align-items: baseline;
  }
  .archive-label {
    grid-column: 1 / span 3;
  }
  .archive-note {
    grid-column: 4 / span 6;
    font-size: 0.9375rem;
  }
  .archive-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .archive-table th {
    text-align: left;
    font-weight: 500;
    padding: 0 1rem 0.9rem 0;
    border-bottom: 1px solid var(--line-2);
  }
  .archive-table td {
    padding: 1.05rem 1rem 1.05rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
    transition:
      color var(--dur-fast) linear,
      background-color var(--dur-fast) linear;
  }
  .archive-table tbody tr:hover td {
    color: var(--ink);
    background: rgb(236 233 227 / 0.025);
  }
  .archive-table td:first-child,
  .archive-table th:first-child {
    width: calc((100% - 11 * var(--col-gap)) / 12 * 3 + 2 * var(--col-gap) + var(--col-gap));
  }
  .col-client {
    font-family: var(--serif);
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .archive-table .mono {
    font-size: 0.75rem;
  }

  @media (max-width: 1080px) {
    .col-stack {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .cases {
      grid-template-columns: 1fr;
    }
    .case-item:nth-child(even) {
      margin-top: 0;
    }
    .archive-label,
    .archive-note {
      grid-column: 1 / -1;
    }
    .archive-table td:first-child,
    .archive-table th:first-child {
      width: 4.5rem;
    }
  }
  @media (max-width: 640px) {
    .col-type {
      display: none;
    }
    .case-results {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .case-results div {
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: baseline;
      padding-block: 0.75rem;
    }
    .archive-table td:nth-child(3) {
      font-size: 0.875rem;
    }
  }
</style>
