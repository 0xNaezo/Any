---
import SectionHead from '../ui/SectionHead.astro';
import Pixel from '../ui/Pixel.astro';
import Mockup from '../mockups/Mockup.astro';
import { ARROW_RIGHT, ICONS } from '@/lib/sprites';
import PixelValue from '../ui/PixelValue.astro';
import { pad2 } from '@/lib/text';
import { localeUrl, type Dictionary } from '@/i18n';

interface Props {
  dict: Dictionary;
  index: number;
}

const { dict, index } = Astro.props;
const w = dict.work;
const total = pad2(w.items.length);
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container">
    <SectionHead index={index} label={w.label} title={w.title} lead={w.lead} id="work-title" />

    <ol class="cases">
      {
        w.items.map((c, i) => {
          const href = localeUrl(dict.locale, `/work/${c.slug}/`);
          return (
            <li class="case" style={`--i:${i}`} data-case>
              <article class="case__card" aria-labelledby={`case-${c.slug}`}>
                <a href={href} class="case__media" tabindex="-1" aria-hidden="true" data-transition>
                  <Mockup kind={c.mockup} cover={c.cover} alt={c.name} class="case__mock" />
                </a>
                <div class="case__info">
                  <div class="case__meta t-mono">
                    <span class="case__idx">
                      <span class="t-pixel">{pad2(i + 1)}</span> / {total}
                    </span>
                    <span>
                      {c.industry} · {c.year}
                    </span>
                  </div>
                  <h3 class="case__name" id={`case-${c.slug}`}>
                    <a href={href} data-transition>{c.name}</a>
                  </h3>
                  <p class="case__kind">{c.kind}</p>
                  <p class="case__summary t-body">{c.summary}</p>
                  <dl class="case__metrics">
                    {c.metrics.map((m) => (
                      <div class="case__metric">
                        <dt>{m.label}</dt>
                        <dd class="t-pixel">
                          <PixelValue value={m.value} />
                        </dd>
                      </div>
                    ))}
                  </dl>
                  <div class="case__foot">
                    <ul class="tags">
                      {c.stack.slice(0, 4).map((t) => (
                        <li class="tag">{t}</li>
                      ))}
                    </ul>
                    <a href={href} class="btn btn--sm case__cta" data-transition>
                      {w.open}
                      <Pixel rows={ARROW_RIGHT} cell={2} />
                    </a>
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>

    <div class="work__nda" data-reveal>
      <Pixel rows={ICONS.lock} cell={2} class="work__nda-icon" />
      <p>{w.nda}</p>
      <a href="#contact" class="link">
        {dict.nav.cta}
        <Pixel rows={ARROW_RIGHT} cell={2} />
      </a>
    </div>
  </div>
</section>

<style>
  .cases {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
  }

  .case {
    position: sticky;
    top: calc(var(--header-h) + 20px + var(--i) * 16px);
  }

  .case__card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: var(--bg-1);
    border: 1px solid var(--line-2);
    transform-origin: 50% 0;
  }

  /* Darkens a card while the next one slides over it (driven by GSAP). */
  .case__card::after {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 2;
    background: var(--bg);
    opacity: var(--shade, 0);
    pointer-events: none;
  }

  .case__media {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(20px, 3.4vw, 48px);
    border-right: 1px solid var(--line);
    background:
      radial-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1.2px) 0 0 / 16px 16px,
      linear-gradient(to bottom, #0b0b0e, #0e0e12);
    overflow: hidden;
  }

  .case__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: repeating-conic-gradient(rgb(255 255 255 / 0.04) 0 25%, transparent 0 50%) 0 0 / 4px 4px;
    mask-image: linear-gradient(to top, #000, transparent);
    pointer-events: none;
  }

  .case__media :global(.case__mock) {
    position: relative;
    z-index: 1;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
    transition: transform 0.5s steps(5);
  }

  .case__card:hover :global(.case__mock) {
    transform: translateY(-6px);
  }

  .case__info {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.8vw, 40px);
    min-width: 0;
  }

  .case__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 11px;
    color: var(--fg-3);
    margin-bottom: clamp(28px, 4vw, 56px);
  }

  .case__idx .t-pixel {
    color: var(--accent);
    font-size: 13px;
  }

  .case__name {
    font-size: clamp(34px, 3.6vw, 52px);
    line-height: 1;
    letter-spacing: -0.045em;
    margin-bottom: 10px;
  }

  .case__name a:hover {
    color: var(--accent);
  }

  .case__kind {
    color: var(--fg-2);
    font-size: 15px;
    margin-bottom: 18px;
  }

  .case__summary {
    max-width: 46ch;
    margin-bottom: 28px;
  }

  .case__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }

  .case__metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
    padding: 16px 12px 16px 0;
  }

  .case__metric + .case__metric {
    padding-left: 14px;
    border-left: 1px solid var(--line);
  }

  .case__metric dd {
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1;
    color: var(--fg);
    white-space: nowrap;
  }

  .case__metric dt {
    font-size: 12px;
    line-height: 1.35;
    color: var(--fg-3);
  }

  .case__foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }

  .work__nda {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: clamp(32px, 4vw, 56px);
    padding: 22px 24px;
    border: 1px dashed var(--line-3);
    color: var(--fg-2);
  }

  .work__nda p {
    flex: 1;
    min-width: 220px;
  }

  .work__nda :global(.work__nda-icon) {
    color: var(--accent);
  }

  .work__nda .link {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .work__nda .link :global(.pixel) {
    width: 12px;
  }

  @media (max-width: 1080px) {
    .case {
      position: static;
    }

    .case__card {
      grid-template-columns: 1fr;
    }

    .case__media {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .case__meta {
      margin-bottom: 24px;
    }
  }

  @media (max-width: 520px) {
    .case__metrics {
      grid-template-columns: 1fr;
    }

    .case__metric,
    .case__metric + .case__metric {
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: baseline;
      padding: 12px 0;
      border-left: 0;
    }

    .case__metric + .case__metric {
      border-top: 1px solid var(--line);
    }

    .case__cta {
      width: 100%;
    }
  }
</style>
