---
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { pricing, site } from '../../content/site';
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <SectionHeader
      index="07"
      eyebrow={pricing.eyebrow}
      title={pricing.title}
      lead={pricing.lead}
      layout="center"
      headingId="pricing-title"
    />

    <ul class="plans" role="list" data-reveal-stagger>
      {
        pricing.plans.map((plan) => (
          <li class:list={['card plan', plan.featured && 'plan--featured']} data-spotlight>
            <span class="spotlight-fill" aria-hidden="true" />
            {plan.featured && <span class="plan-border" aria-hidden="true" />}
            <div class="plan-head">
              <h3 class="plan-name">{plan.name}</h3>
              {plan.badge && <span class="plan-badge">{plan.badge}</span>}
            </div>
            <p class="plan-desc">{plan.description}</p>
            <p class="plan-price">
              {plan.prefix && <span class="plan-prefix">{plan.prefix}</span>}
              <span class="plan-amount">{plan.price}</span>
              <span class="plan-unit">{plan.unit}</span>
            </p>
            <Button
              href={plan.cta.href}
              variant={plan.featured ? 'primary' : 'ghost'}
              arrow
              class="plan-cta"
              magnetic={plan.featured}
            >
              {plan.cta.label}
            </Button>
            <ul class="plan-features" role="list">
              {plan.features.map((f) => (
                <li>
                  <span class="plan-check" aria-hidden="true">
                    <Icon name="check" size={12} strokeWidth={2.4} />
                  </span>
                  {f}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <p class="pricing-note" data-reveal>
      <Icon name="calendar" size={18} />
      <span>{pricing.note}</span>
      <a class="link" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Pick a time →</a>
    </p>
  </div>
</section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
    padding: 0;
    list-style: none;
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.2rem);
  }

  .plan--featured {
    background:
      radial-gradient(90% 60% at 50% 0%, rgb(var(--accent-rgb) / 0.16), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015)),
      var(--surface-2);
    box-shadow:
      var(--shadow-card),
      0 30px 80px -30px rgb(var(--accent-rgb) / 0.35);
  }

  /* animated gradient border for the highlighted plan */
  .plan-border {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from var(--angle, 0deg), rgb(var(--accent-rgb) / 0.15), var(--accent), var(--accent-2), rgb(var(--accent-rgb) / 0.15) 40%, rgb(var(--accent-rgb) / 0.15));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: border-spin 6s linear infinite;
    pointer-events: none;
  }

  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes border-spin {
    to {
      --angle: 360deg;
    }
  }

  .plan-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 28px;
  }

  .plan-name {
    font-size: 1.15rem;
    font-weight: 550;
    letter-spacing: -0.025em;
  }

  .plan-badge {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 520;
    color: #0b0b12;
    background: var(--grad-accent);
    box-shadow: 0 0 20px rgb(var(--accent-rgb) / 0.5);
  }

  .plan-desc {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--text-3);
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 2rem 0 1.6rem;
  }

  .plan-prefix {
    font-size: 0.9rem;
    color: var(--text-3);
  }

  .plan-amount {
    font-size: clamp(2.6rem, 2rem + 2vw, 3.4rem);
    font-weight: 540;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .plan-unit {
    font-size: 0.9rem;
    color: var(--text-2);
  }

  .plan :global(.plan-cta) {
    width: 100%;
  }

  .plan-features {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.8rem;
    padding: 1.6rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: var(--text-2);
    line-height: 1.45;
  }

  .plan-check {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 0.05rem;
    border-radius: 50%;
    flex: none;
    color: var(--accent);
    background: rgb(var(--accent-rgb) / 0.12);
    box-shadow: inset 0 0 0 1px rgb(var(--accent-rgb) / 0.3);
  }

  .plan--featured .plan-check {
    color: #0b0b12;
    background: var(--accent);
  }

  .pricing-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem 0.8rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    text-align: center;
    color: var(--text-2);
    font-size: 0.95rem;
  }

  .pricing-note :global(svg) {
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .plans {
      grid-template-columns: 1fr;
      max-width: 34rem;
      margin-inline: auto;
    }
  }
</style>
