---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { services } from '../../content/site';
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <SectionHeader
      index="01"
      eyebrow={services.eyebrow}
      title={services.title}
      lead={services.lead}
      layout="split"
      headingId="services-title"
    />

    <ul class="services-grid" role="list" data-reveal-stagger>
      {
        services.items.map((item, i) => (
          <li class="card service" data-spotlight>
            <span class="spotlight-fill" aria-hidden="true" />
            <div class="service-top">
              <span class="icon-tile">
                <Icon name={item.icon} size={22} />
              </span>
              <span class="service-index mono">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="h-card">{item.title}</h3>
            <p class="service-text">{item.text}</p>
            <ul class="tags" role="list">
              {item.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    min-height: 290px;
  }

  .service-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 1.6rem;
  }

  .service-index {
    font-size: 0.75rem;
    color: var(--text-3);
    letter-spacing: 0.08em;
  }

  .service-text {
    color: var(--text-2);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .service .tags {
    margin-top: auto;
    padding-top: 0.6rem;
  }

  @media (max-width: 1000px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .service {
      min-height: 0;
    }

    .service-top {
      padding-bottom: 1rem;
    }
  }
</style>
