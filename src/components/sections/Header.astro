---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { nav, site } from '../../content/site';
---

<header class="nav" data-nav>
  <div class="nav-bar">
    <a href="/" class="nav-logo" aria-label={`${site.name} — home`}>
      <Logo size={26} />
    </a>

    <nav class="nav-links" aria-label="Main">
      <ul role="list">
        {
          nav.map((link) => (
            <li>
              <a href={link.href} data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-actions">
      <span class="nav-status">
        <span class="status-dot" aria-hidden="true"></span>
        {site.availability.short}
      </span>
      <Button href="/#contact" size="sm" arrow magnetic class="nav-cta">Start a project</Button>
      <button
        class="nav-burger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu hidden>
  <nav aria-label="Mobile">
    <ul role="list">
      {
        nav.map((link, i) => (
          <li>
            <a href={link.href} data-menu-link>
              <span class="mobile-menu-index mono">{String(i + 1).padStart(2, '0')}</span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-menu-footer" data-menu-footer>
    <Button href="/#contact" size="lg" arrow data-menu-link>Start a project</Button>
    <a class="mobile-menu-mail" href={`mailto:${site.email}`}>
      <Icon name="mail" size={18} />
      {site.email}
    </a>
    <ul class="mobile-menu-socials" role="list">
      {
        site.socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
              <Icon name={s.icon} size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 12px var(--gutter) 0;
    transition: transform 0.6s var(--ease-out);
    pointer-events: none;
  }

  .nav.is-hidden {
    transform: translate3d(0, -130%, 0);
  }

  .nav-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: calc(var(--container) + 2rem);
    height: 60px;
    margin-inline: auto;
    padding: 0 10px 0 18px;
    border-radius: 999px;
    pointer-events: auto;
    transition:
      background-color 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      backdrop-filter 0.5s var(--ease-out);
  }

  .nav.is-scrolled .nav-bar,
  .nav.is-open .nav-bar {
    background: rgb(12 12 19 / 0.66);
    box-shadow:
      inset 0 0 0 1px var(--line-2),
      inset 0 1px 0 0 rgb(255 255 255 / 0.05),
      0 16px 40px -16px rgb(0 0 0 / 0.75);
    backdrop-filter: blur(18px) saturate(150%);
  }

  .nav-logo {
    display: inline-flex;
    padding: 6px 4px;
    border-radius: 10px;
  }

  .nav-links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .nav-links ul {
    display: flex;
    gap: 2px;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    position: relative;
    display: block;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--text-2);
    transition:
      color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }

  .nav-links a.is-active {
    color: var(--text);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out);
  }

  .nav-links a.is-active::after {
    opacity: 1;
    transform: scale(1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .nav-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8rem;
    color: var(--text-2);
    white-space: nowrap;
  }

  .nav-burger {
    display: none;
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .nav-burger span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text);
    transition:
      transform 0.5s var(--ease-out),
      top 0.5s var(--ease-out);
  }

  .nav-burger span:first-child {
    top: 17px;
  }

  .nav-burger span:last-child {
    top: 24px;
  }

  .nav.is-open .nav-burger span:first-child {
    top: 20.5px;
    transform: rotate(45deg);
  }

  .nav.is-open .nav-burger span:last-child {
    top: 20.5px;
    transform: rotate(-45deg);
  }

  @media (max-width: 1100px) {
    .nav-status {
      display: none;
    }
  }

  @media (max-width: 920px) {
    .nav-links {
      display: none;
    }

    .nav-burger {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .nav-bar {
      height: 56px;
      padding-left: 14px;
      padding-right: 7px;
    }

    .nav-actions :global(.nav-cta) {
      display: none;
    }
  }

  /* ── Mobile menu ─────────────────────────────────────────── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: calc(var(--nav-h) + 2.5rem) var(--gutter) calc(2rem + env(safe-area-inset-bottom));
    background:
      radial-gradient(120% 60% at 100% 0%, rgb(var(--accent-rgb) / 0.14), transparent 60%),
      rgb(5 5 8 / 0.97);
    backdrop-filter: blur(20px);
    overflow-y: auto;
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0;
  }

  .mobile-menu nav li {
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    font-size: clamp(1.9rem, 1.4rem + 3vw, 2.6rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .mobile-menu-index {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .mobile-menu-footer {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .mobile-menu-mail {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-2);
  }

  .mobile-menu-socials {
    display: flex;
    gap: 0.6rem;
  }

  .mobile-menu-socials a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--text-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
</style>
