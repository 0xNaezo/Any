---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { faq, site } from '../../content/site';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="faq-aside">
      <SectionHeader index="08" eyebrow={faq.eyebrow} title={faq.title} lead={faq.lead} headingId="faq-title">
        <a class="faq-mail" href={`mailto:${site.email}`} data-reveal>
          <span class="icon-tile"><Icon name="mail" /></span>
          <span>
            <small>Email us directly</small>
            {site.email}
          </span>
        </a>
      </SectionHeader>
    </div>

    <div class="faq-list" data-faq data-reveal-stagger>
      {
        faq.items.map((item, i) => (
          <details class="faq-item" open={i === 0} data-faq-item>
            <summary>
              <span class="faq-q">{item.q}</span>
              <span class="faq-icon" aria-hidden="true">
                <Icon name="plus" size={16} strokeWidth={2} />
              </span>
            </summary>
            <div class="faq-a" data-faq-answer>
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .faq-aside :global(.section-head) {
    position: sticky;
    top: calc(var(--nav-h) + 3rem);
    margin-bottom: 0;
  }

  .faq-mail {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.6rem;
    padding: 0.6rem 1.2rem 0.6rem 0.6rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-weight: 520;
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
    justify-self: start;
  }

  .faq-mail:hover {
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px var(--line-3);
  }

  .faq-mail .icon-tile {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .faq-mail > span:last-child {
    display: grid;
    line-height: 1.3;
  }

  .faq-mail small {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-3);
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.2rem);
    font-weight: 520;
    letter-spacing: -0.02em;
    line-height: 1.35;
    transition: color 0.3s;
  }

  .faq-item summary:hover .faq-q {
    color: #fff;
  }

  .faq-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    color: var(--text-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.4s,
      color 0.4s,
      box-shadow 0.4s;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #0b0b12;
    background: var(--text);
    box-shadow: none;
  }

  .faq-a {
    overflow: hidden;
  }

  .faq-a p {
    padding-bottom: 1.6rem;
    padding-right: 3.5rem;
    color: var(--text-2);
    line-height: 1.7;
    max-width: 44rem;
  }

  @media (max-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .faq-aside :global(.section-head) {
      position: static;
    }

    .faq-a p {
      padding-right: 0;
    }
  }
</style>
