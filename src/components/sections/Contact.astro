---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { contact, site } from '../../content/site';
import { GHOST_BODY, GHOST_EYES } from '../../lib/ghost';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? '';
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="contact-glow" aria-hidden="true"></div>
  <div class="container contact-grid">
    <div class="contact-aside">
      <SectionHeader index="09" eyebrow={contact.eyebrow} title={contact.title} lead={contact.lead} headingId="contact-title" />

      <div class="contact-options" data-reveal-stagger>
        <a class="contact-option" href={`mailto:${site.email}`}>
          <span class="icon-tile"><Icon name="mail" /></span>
          <span>
            <small>Email</small>
            <strong>{site.email}</strong>
          </span>
          <Icon name="arrow-up-right" size={18} class="contact-option-arrow" />
        </a>
        <a class="contact-option" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">
          <span class="icon-tile"><Icon name="calendar" /></span>
          <span>
            <small>Prefer to talk?</small>
            <strong>Book a 30-min intro call</strong>
          </span>
          <Icon name="arrow-up-right" size={18} class="contact-option-arrow" />
        </a>
      </div>

      <div class="contact-next" data-reveal>
        <p class="contact-next-title mono">{contact.next.title}</p>
        <ol role="list">
          {
            contact.next.steps.map((step, i) => (
              <li>
                <span class="contact-next-num mono">{i + 1}</span>
                {step}
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="contact-form-wrap" data-reveal>
      <form
        class="card form"
        method="post"
        action={endpoint || `mailto:${site.email}`}
        enctype={endpoint ? undefined : 'text/plain'}
        data-contact-form
        data-endpoint={endpoint}
        data-access-key={accessKey}
        data-email={site.email}
        data-error-text={contact.form.error}
      >
        <div class="form-fields" data-form-fields>
          <div class="form-row form-row--2">
            <label class="field">
              <span class="field-label">Your name <span aria-hidden="true">*</span></span>
              <input type="text" name="name" required autocomplete="name" placeholder="Jane Cooper" />
              <span class="field-error" data-error-for="name">Please tell us your name.</span>
            </label>
            <label class="field">
              <span class="field-label">Work email <span aria-hidden="true">*</span></span>
              <input type="email" name="email" required autocomplete="email" placeholder="jane@company.com" />
              <span class="field-error" data-error-for="email">Please enter a valid email.</span>
            </label>
          </div>

          <label class="field">
            <span class="field-label">Company <span class="field-optional">optional</span></span>
            <input type="text" name="company" autocomplete="organization" placeholder="Acme Inc." />
          </label>

          <fieldset class="chips">
            <legend class="field-label">What do you need?</legend>
            <div class="chips-list">
              {
                contact.form.services.map((s) => (
                  <label class="chip">
                    <input type="checkbox" name="services" value={s} />
                    <span>{s}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="chips">
            <legend class="field-label">Estimated budget</legend>
            <div class="chips-list">
              {
                contact.form.budgets.map((b) => (
                  <label class="chip">
                    <input type="radio" name="budget" value={b} />
                    <span>{b}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <label class="field">
            <span class="field-label">Tell us about your project <span aria-hidden="true">*</span></span>
            <textarea
              name="message"
              rows="5"
              required
              minlength="10"
              placeholder="Goals, timeline, links — anything that helps us understand what you’re building."
            ></textarea>
            <span class="field-error" data-error-for="message">A couple of sentences is enough to get started.</span>
          </label>

          <label class="form-hp" aria-hidden="true">
            Leave this field empty
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>

          <div class="form-foot">
            <p class="form-privacy">
              <Icon name="lock" size={15} />
              {contact.form.privacy}
            </p>
            <button type="submit" class="btn btn--primary btn--lg form-submit" data-magnetic>
              <span class="btn-label" data-magnetic-inner>{contact.form.submit}</span>
              <span class="btn-chip" aria-hidden="true">
                <Icon name="arrow-right" size={14} strokeWidth={2} />
                <Icon name="arrow-right" size={14} strokeWidth={2} />
              </span>
            </button>
          </div>
          <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        </div>

        <div class="form-success" data-form-success hidden>
          <svg class="form-success-ghost" viewBox="0 0 32 32" aria-hidden="true">
            <defs>
              <linearGradient id="success-ghost" x1="22" y1="5" x2="8" y2="29" gradientUnits="userSpaceOnUse">
                <stop stop-color="#ffffff"></stop>
                <stop offset="0.5" stop-color="#e4deff"></stop>
                <stop offset="1" stop-color="#9d8bff"></stop>
              </linearGradient>
            </defs>
            <path fill="url(#success-ghost)" d={GHOST_BODY}></path>
            {GHOST_EYES.map((e) => <path d={`M${e.cx - 1.5} ${e.cy + 0.6}q1.5-2.2 3 0`} fill="none" stroke="#0a0912" stroke-width="0.9" stroke-linecap="round" />)}
          </svg>
          <h3 class="h-card">{contact.form.success.title}</h3>
          <p>{contact.form.success.text}</p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    overflow: clip;
  }

  .contact-glow {
    position: absolute;
    left: 50%;
    bottom: -30%;
    width: min(110vw, 1400px);
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(var(--accent-rgb) / 0.13), rgb(var(--accent-2-rgb) / 0.04) 55%, transparent 75%);
    pointer-events: none;
    z-index: -1;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .contact-aside :global(.section-head) {
    margin-bottom: 2.5rem;
  }

  .contact-options {
    display: grid;
    gap: 0.75rem;
  }

  .contact-option {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.2rem 0.9rem 0.9rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.025);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .contact-option:hover {
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px var(--line-3);
  }

  .contact-option > span:nth-child(2) {
    display: grid;
    line-height: 1.35;
    min-width: 0;
  }

  .contact-option small {
    font-size: 0.78rem;
    color: var(--text-3);
  }

  .contact-option strong {
    font-weight: 520;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .contact-option :global(.contact-option-arrow) {
    margin-left: auto;
    flex: none;
    color: var(--text-3);
    transition:
      transform 0.4s var(--ease-out),
      color 0.3s;
  }

  .contact-option:hover :global(.contact-option-arrow) {
    color: var(--text);
    transform: translate(2px, -2px);
  }

  .contact-next {
    margin-top: 2.5rem;
  }

  .contact-next-title {
    margin-bottom: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .contact-next ol {
    display: grid;
    gap: 0.8rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .contact-next li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--text-2);
  }

  .contact-next-num {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex: none;
    font-size: 0.72rem;
    color: var(--accent);
    background: rgb(var(--accent-rgb) / 0.1);
    box-shadow: inset 0 0 0 1px rgb(var(--accent-rgb) / 0.3);
  }

  /* ── Form ───────────────────────────────────────────────── */
  .form {
    padding: clamp(1.4rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(80% 50% at 100% 0%, rgb(var(--accent-rgb) / 0.1), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.012)),
      var(--surface);
    box-shadow:
      var(--shadow-card),
      0 40px 100px -40px rgb(var(--accent-rgb) / 0.25);
  }

  .form-fields {
    display: grid;
    gap: 1.4rem;
  }

  .form-row--2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-2);
  }

  .field-optional {
    margin-left: 0.3rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-3);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 0;
    border-radius: 12px;
    background: rgb(0 0 0 / 0.3);
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
    transition:
      box-shadow 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }

  .field textarea {
    resize: vertical;
    min-height: 130px;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: rgb(166 166 186 / 0.45);
  }

  .field input:hover,
  .field textarea:hover {
    box-shadow: inset 0 0 0 1px var(--line-3);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    background: rgb(0 0 0 / 0.4);
    box-shadow:
      inset 0 0 0 1px rgb(var(--accent-rgb) / 0.8),
      0 0 0 4px rgb(var(--accent-rgb) / 0.15);
  }

  .field-error {
    display: none;
    font-size: 0.78rem;
    color: #ff9a9a;
  }

  .field.is-invalid input,
  .field.is-invalid textarea {
    box-shadow:
      inset 0 0 0 1px rgb(255 122 122 / 0.8),
      0 0 0 4px rgb(255 122 122 / 0.12);
  }

  .field.is-invalid .field-error {
    display: block;
  }

  .chips {
    padding: 0;
    margin: 0;
    border: 0;
    min-width: 0;
  }

  .chips legend {
    margin-bottom: 0.7rem;
    padding: 0;
  }

  .chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    position: relative;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding: 0 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--text-2);
    background: rgb(255 255 255 / 0.025);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition:
      color 0.25s,
      background-color 0.25s,
      box-shadow 0.25s;
    user-select: none;
  }

  .chip:hover span {
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-3);
  }

  .chip input:checked + span {
    color: #0b0b12;
    background: var(--text);
    box-shadow: 0 0 20px -4px rgb(var(--accent-rgb) / 0.7);
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .form-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-top: 0.4rem;
  }

  .form-privacy {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 19rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-3);
  }

  .form-privacy :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }

  .form-submit[disabled] {
    opacity: 0.7;
    pointer-events: none;
  }

  .form-status {
    min-height: 1.2em;
    font-size: 0.85rem;
    color: #ff9a9a;
  }

  .form-status:empty {
    display: none;
  }

  .form-success {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    padding: 3rem 1rem;
    text-align: center;
  }

  .form-success p {
    color: var(--text-2);
    max-width: 24rem;
  }

  .form-success-ghost {
    width: 88px;
    height: 88px;
    margin-bottom: 0.6rem;
    filter: drop-shadow(0 0 24px rgb(var(--accent-rgb) / 0.6));
    animation: float 3.2s ease-in-out infinite;
  }

  @keyframes float {
    50% {
      transform: translateY(-8px) rotate(-3deg);
    }
  }

  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .form-row--2 {
      grid-template-columns: 1fr;
    }

    .form-submit {
      width: 100%;
    }
  }
</style>
