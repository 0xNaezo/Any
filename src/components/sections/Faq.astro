---
import { site } from '@/data/site';
import Frame from '@/components/ui/Frame.astro';
import Ghost from '@/components/ui/Ghost.astro';
import PixelIcon from '@/components/ui/PixelIcon.astro';

const { faq, brand } = site;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<div class="container section">
  <Frame id="faq" label={faq.label} meta={faq.meta} labelledby="faq-title">
    <div class="faq">
      <div class="faq__intro">
        <h2 id="faq-title" class="h-section" data-reveal="wipe">{faq.title}</h2>
        <p class="lead" data-reveal>{faq.lead}</p>
        <div class="faq__ask" data-reveal>
          <Ghost size={60} eyes="happy" fill="dither" />
          <a class="link" href={`mailto:${brand.email}`}>{brand.email}</a>
        </div>
      </div>

      <div class="faq__list" data-reveal-stagger>
        {
          faq.items.map((f, i) => (
            <details class="qa" data-qa data-reveal-item>
              <summary class="qa__q">
                <span class="qa__no px" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="qa__text">{f.q}</span>
                <span class="qa__toggle" aria-hidden="true">
                  <PixelIcon name="plus" class="qa__plus" />
                  <PixelIcon name="minus" class="qa__minus" />
                </span>
              </summary>
              <div class="qa__a" data-qa-body>
                <p class="small">{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </Frame>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</div>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  @media (min-width: 1000px) {
    .faq {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 64px;
      align-items: start;
    }
    .faq__intro {
      position: sticky;
      top: calc(var(--nav-h) + 40px);
    }
  }
  .faq__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    justify-items: start;
  }
  .faq__intro .lead {
    color: var(--ink-2);
  }
  .faq__ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    color: var(--accent);
  }
  @media (max-width: 379px) {
    .faq__ask .link {
      font-size: 14px;
    }
  }

  .qa {
    background: repeating-linear-gradient(90deg, var(--line-2) 0 4px, transparent 4px 8px) top / 100% 1px no-repeat;
  }
  .qa:last-child {
    box-shadow: inset 0 -1px 0 0 transparent;
    background:
      repeating-linear-gradient(90deg, var(--line-2) 0 4px, transparent 4px 8px) top / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, var(--line-2) 0 4px, transparent 4px 8px) bottom / 100% 1px no-repeat;
  }
  .qa__q {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 32px;
    align-items: center;
    gap: 16px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--t-fast) steps(2);
  }
  .qa__q::-webkit-details-marker {
    display: none;
  }
  .qa__q:hover {
    background-color: var(--tint);
  }
  .qa__no {
    font-size: 16px;
    color: var(--ink-3);
  }
  .qa__text {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
  }
  .qa[open] .qa__text {
    color: var(--accent);
  }
  .qa__toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition:
      background-color var(--t-fast) steps(2),
      color var(--t-fast) steps(2);
  }
  .qa__q:hover .qa__toggle,
  .qa[open] .qa__toggle {
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: none;
  }
  .qa :global(.qa__minus) {
    display: none;
  }
  .qa[open] :global(.qa__minus) {
    display: block;
  }
  .qa[open] :global(.qa__plus) {
    display: none;
  }
  .qa__a {
    overflow: hidden;
  }
  .qa__a p {
    padding: 0 48px 24px 60px;
    color: var(--ink-2);
    max-width: 68ch;
  }
  @media (max-width: 599px) {
    .qa__q {
      grid-template-columns: 28px minmax(0, 1fr) 32px;
      gap: 12px;
    }
    .qa__a p {
      padding: 0 8px 20px 40px;
    }
  }
</style>
