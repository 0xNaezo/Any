---
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import { team } from '../../data/site';

/*
 * Until real photos are added, each person gets a "woven" bust: the same warp-thread
 * texture as the hero, revealed through a soft silhouette mask. Four slight variations
 * keep the row from looking cloned.
 */
const busts = [
  { cx: 48, cy: 47, rx: 15, ry: 19, sw: 37, tilt: -3 },
  { cx: 52, cy: 49, rx: 14, ry: 18.5, sw: 33, tilt: 4 },
  { cx: 50, cy: 46, rx: 15.5, ry: 19.5, sw: 39, tilt: 0 },
  { cx: 49, cy: 48, rx: 14, ry: 18, sw: 34, tilt: -5 },
];

function bustMask(i: number) {
  const b = busts[i % busts.length];
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 125"><defs><filter id="b" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="0.7"/></filter></defs><g filter="url(#b)" fill="#fff"><ellipse cx="${b.cx}" cy="${b.cy}" rx="${b.rx}" ry="${b.ry}" transform="rotate(${b.tilt} ${b.cx} ${b.cy})"/><rect x="${b.cx - 6.5}" y="${b.cy + 12}" width="13" height="18" rx="4"/><path d="M${50 - b.sw - 4} 126C${50 - b.sw} 100 ${50 - b.sw * 0.5} 86 50 86S${50 + b.sw} 100 ${50 + b.sw + 4} 126Z"/></g></svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
}

const initials = (name: string) =>
  name
    .split(' ')
    .map((p) => p[0])
    .join('');
---

<section id="team" class="section team" aria-labelledby="team-title">
  <div class="container">
    <SectionHead id="team-title" index={team.index} label={team.label} title={team.title} lede={team.lede} />

    <ul class="members">
      {
        team.members.map((m, i) => (
          <li class="member" data-reveal>
            <figure class="portrait">
              {m.photo ? (
                <img src={m.photo} alt={`Portrait of ${m.name}`} loading="lazy" decoding="async" />
              ) : (
                <div class="weave" aria-hidden="true">
                  <span class="weave-figure" style={`--mask:${bustMask(i)}`} />
                </div>
              )}
              <figcaption class="portrait-meta">
                <span class="label label--ink">{initials(m.name)}</span>
                <span class="label">{m.years} yrs</span>
              </figcaption>
            </figure>

            <h3 class="member-name display">{m.name}</h3>
            <p class="label member-role">{m.role}</p>
            <p class="member-bio">{m.bio}</p>
            <p class="member-focus mono">
              {m.focus.join(' · ')}
            </p>
            <ul class="member-links">
              {m.links.map((l) => (
                <li>
                  <a class="link label label--2" href={l.url} target="_blank" rel="noopener">
                    {l.label}
                    <Icon name="arrow-up-right" size={11} />
                    <span class="visually-hidden">— {m.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .members {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 4rem;
  }
  .member {
    display: flex;
    flex-direction: column;
  }

  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background: #101012;
    margin-bottom: 1.5rem;
  }
  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--line);
    pointer-events: none;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(0.9);
    transition:
      filter 900ms var(--ease-out),
      transform 1.1s var(--ease-out);
  }
  .member:hover .portrait img {
    filter: grayscale(0.15) contrast(1) brightness(1);
    transform: scale(1.02);
  }

  .weave {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 60% at 50% 35%, rgb(201 212 238 / 0.06), transparent 70%),
      repeating-linear-gradient(90deg, rgb(236 233 227 / 0.07) 0 1px, transparent 1px 7px);
  }
  .weave-figure {
    position: absolute;
    inset: 8% 0 0;
    background:
      linear-gradient(to bottom, rgb(11 11 12 / 0) 55%, rgb(11 11 12 / 0.65) 100%),
      repeating-linear-gradient(90deg, rgb(236 233 227 / 0.78) 0 1.25px, transparent 1.25px 7px);
    -webkit-mask: var(--mask) center bottom / 100% auto no-repeat;
    mask: var(--mask) center bottom / 100% auto no-repeat;
    transition:
      transform 1.4s var(--ease-out),
      opacity 600ms linear;
    opacity: 0.85;
  }
  .member:hover .weave-figure {
    transform: translateY(-1.5%);
    opacity: 1;
  }

  .portrait::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    z-index: 1;
    background: linear-gradient(to top, rgb(11 11 12 / 0.85), rgb(11 11 12 / 0));
    pointer-events: none;
  }
  .portrait-meta {
    z-index: 2;
    position: absolute;
    inset: auto 0.9rem 0.85rem 0.9rem;
    display: flex;
    justify-content: space-between;
  }

  .member-name {
    font-size: var(--display-xs);
    line-height: 1.1;
    letter-spacing: -0.014em;
  }
  .member-role {
    margin-top: 0.5rem;
  }
  .member-bio {
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: 0.9688rem;
    line-height: 1.6;
  }
  .member-focus {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .member-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 0.85rem;
  }

  @media (max-width: 1080px) {
    .members {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .members {
      grid-template-columns: 1fr;
      row-gap: 3.5rem;
    }
    .portrait {
      aspect-ratio: 5 / 4;
    }
    .weave-figure {
      inset: 4% 18% 0;
    }
  }
</style>
