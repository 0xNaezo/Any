---
import { Image } from 'astro:assets';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { team } from '../../content/site';
---

<section class="section team" id="team" aria-labelledby="team-title">
  <div class="container">
    <SectionHeader index="05" eyebrow={team.eyebrow} title={team.title} lead={team.lead} layout="split" headingId="team-title" />

    <ul class="team-grid" role="list" data-reveal-stagger>
      {
        team.members.map((m) => (
          <li class="member">
            <div class="member-photo">
              <Image src={m.photo} alt={`Portrait of ${m.name}`} widths={[320, 480, 640]} sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 300px" />
              <span class="member-years mono">{m.years} yrs exp.</span>
              <ul class="member-links" role="list">
                {m.links.map((l) => (
                  <li>
                    <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`${m.name} on ${l.label}`}>
                      <Icon name={l.icon} size={15} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="member-info">
              <h3 class="member-name">{m.name}</h3>
              <p class="member-role">{m.role}</p>
              <p class="member-bio">{m.bio}</p>
              <ul class="tags" role="list">
                {m.skills.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
              <ul class="member-links member-links--inline" role="list">
                {m.links.map((l) => (
                  <li>
                    <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`${m.name} on ${l.label}`}>
                      <Icon name={l.icon} size={15} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="team-note" data-reveal>
      <Icon name="globe" size={16} />
      {team.note}
    </p>
  </div>
</section>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: 0;
    list-style: none;
  }

  .member {
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }

  .member-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-2);
    box-shadow:
      0 0 0 1px var(--line-2),
      0 30px 60px -30px rgb(0 0 0 / 0.8);
    isolation: isolate;
  }

  .member-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.05);
    transform: scale(1.01);
    transition:
      transform 1.2s var(--ease-out),
      filter 0.8s var(--ease-out);
  }

  .member-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(5 5 8 / 0.65));
    pointer-events: none;
  }

  .member:hover .member-photo :global(img) {
    transform: scale(1.06);
    filter: grayscale(0) contrast(1.05);
  }

  .member-years {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    z-index: 1;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    font-size: 0.7rem;
    color: var(--text);
    background: rgb(5 5 8 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    backdrop-filter: blur(8px);
  }

  .member-links {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 1;
    display: flex;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .member-links a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--text);
    background: rgb(5 5 8 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    backdrop-filter: blur(8px);
    transition:
      background-color 0.3s,
      transform 0.4s var(--ease-out);
  }

  .member-links a:hover {
    background: rgb(var(--accent-rgb) / 0.4);
    transform: translateY(-2px);
  }

  @media (hover: hover) and (pointer: fine) {
    .member-photo .member-links li {
      opacity: 0;
      transform: translateY(-6px);
      transition:
        opacity 0.4s var(--ease-out),
        transform 0.5s var(--ease-out);
    }

    .member-photo .member-links li:nth-child(2) {
      transition-delay: 0.05s;
    }

    .member:hover .member-photo .member-links li,
    .member:focus-within .member-photo .member-links li {
      opacity: 1;
      transform: none;
    }
  }

  .member-info {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .member-links--inline {
    display: none;
  }

  .member-name {
    font-size: 1.2rem;
    font-weight: 550;
    letter-spacing: -0.03em;
  }

  .member-role {
    font-size: 0.85rem;
    color: var(--accent);
  }

  .member-bio {
    margin: 0.35rem 0 0.6rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-2);
  }

  .team-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-3);
  }

  @media (max-width: 1100px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
  }

  @media (max-width: 560px) {
    .team-grid {
      grid-template-columns: 1fr;
    }

    .member {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      align-items: start;
      gap: 1rem;
    }

    .member-photo {
      border-radius: var(--radius);
    }

    .member-years {
      display: none;
    }

    .member-photo .member-links {
      display: none;
    }

    .member-links--inline {
      display: flex;
      position: static;
      margin-top: 0.6rem;
    }
  }
</style>
