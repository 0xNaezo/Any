---
import SectionHead from '../ui/SectionHead.astro';
import Sprite from '../ui/Sprite.astro';
import Pixel from '../ui/Pixel.astro';
import { ARROW_UP_RIGHT, AVATARS } from '@/lib/sprites';
import { pad2 } from '@/lib/text';
import { assetUrl, type Dictionary } from '@/i18n';

interface Props {
  dict: Dictionary;
  index: number;
}

const { dict, index } = Astro.props;
const t = dict.team;
const palette = { '#': 'body', '+': 'gray', '*': 'accent' };
---

<section class="section team" id="team" aria-labelledby="team-title">
  <div class="container">
    <SectionHead index={index} label={t.label} title={t.title} lead={t.lead} id="team-title" />

    <ul class="team__grid">
      {
        t.members.map((m, i) => (
          <li class="member" data-reveal>
            <div class="member__photo">
              <span class="member__tag t-mono">NL-{pad2(i + 1)}</span>
              <span class="member__years t-mono">
                <span class="t-pixel">{m.years}</span>y
              </span>
              {m.photo ? (
                <img src={assetUrl(m.photo)} alt={m.name} loading="lazy" decoding="async" class="member__img" />
              ) : (
                <div class="member__avatar">
                  <Sprite rows={AVATARS[m.avatar]} palette={palette} gap={0.12} />
                </div>
              )}
            </div>
            <div class="member__body">
              <h3 class="member__name">{m.name}</h3>
              <p class="member__role t-mono">{m.role}</p>
              <p class="member__bio">{m.bio}</p>
              <p class="member__exp t-mono">{t.experience(m.years)}</p>
              <ul class="tags">
                {m.skills.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
              <ul class="member__links">
                {m.links.map((l) => (
                  <li>
                    <a class="link" href={l.href} target="_blank" rel="noopener">
                      {l.label}
                      <Pixel rows={ARROW_UP_RIGHT} cell={1} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .member {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .member__photo {
    --sprite-gap: #0c0c0f;
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background:
      radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1.2px) 0 0 / 14px 14px,
      #0c0c0f;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .member__photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: repeating-conic-gradient(rgb(255 255 255 / 0.05) 0 25%, transparent 0 50%) 0 0 / 4px 4px;
    mask-image: linear-gradient(to top, #000, transparent);
    pointer-events: none;
  }

  .member__avatar {
    width: 58%;
    transition: transform 0.45s steps(3);
  }

  .member:hover .member__avatar {
    transform: translateY(-6%);
  }

  .member__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.4s steps(4);
  }

  .member:hover .member__img {
    filter: grayscale(0);
  }

  .member__tag,
  .member__years {
    position: absolute;
    top: 14px;
    z-index: 1;
    font-size: 10px;
    color: var(--fg-3);
  }

  .member__tag {
    left: 14px;
  }

  .member__years {
    right: 14px;
  }

  .member__years .t-pixel {
    font-size: 13px;
    color: var(--fg);
    margin-right: 1px;
  }

  .member__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(20px, 2vw, 28px);
  }

  .member__name {
    font-size: clamp(20px, 1.6vw, 24px);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: 8px;
  }

  .member__role {
    font-size: 11px;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .member__bio {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-2);
    margin-bottom: 16px;
  }

  .member__exp {
    font-size: 11px;
    color: var(--fg-3);
    margin-bottom: 14px;
    margin-top: auto;
  }

  .member__links {
    display: flex;
    gap: 18px;
    margin-top: 18px;
    font-size: 13px;
    color: var(--fg-2);
  }

  .member__links a:hover {
    color: var(--fg);
  }

  .member__links :global(.pixel) {
    width: 6px;
    opacity: 0.6;
  }

  @media (max-width: 1080px) {
    .team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .team__grid {
      grid-template-columns: 1fr;
    }

    .member__photo {
      aspect-ratio: 16 / 11;
    }

    .member__avatar {
      width: 40%;
    }
  }
</style>
