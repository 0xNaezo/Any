---
import SectionHead from '../ui/SectionHead.astro';
import Pixel from '../ui/Pixel.astro';
import { QUOTE } from '@/lib/sprites';
import type { Dictionary } from '@/i18n';

interface Props {
  dict: Dictionary;
  index: number;
}

const { dict, index } = Astro.props;
const t = dict.testimonials;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .replace(/\./g, '')
    .slice(0, 2)
    .toUpperCase();
---

<section class="section reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <SectionHead index={index} label={t.label} title={t.title} id="reviews-title" />

    <ul class="reviews__grid">
      {
        t.items.map((r, i) => (
          <li class:list={['review', { 'review--wide': i === 0 }]} data-reveal>
            <figure>
              <Pixel rows={QUOTE} cell={3} class="review__mark" />
              <blockquote class="review__text">
                <p>{r.text}</p>
              </blockquote>
              <figcaption class="review__author">
                <span class="review__ava" aria-hidden="true">
                  {initials(r.author)}
                </span>
                <span>
                  <span class="review__name">{r.author}</span>
                  <span class="review__role t-mono">
                    {r.role} · {r.company}
                  </span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .review {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .review--wide {
    grid-column: 1 / -1;
  }

  .review--wide figure {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    grid-template-rows: auto 1fr;
    column-gap: var(--col-gap);
  }

  .review--wide :global(.review__mark) {
    grid-column: 1;
  }

  .review--wide .review__text {
    grid-column: 1;
    grid-row: 2;
  }

  .review--wide .review__author {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
    justify-self: end;
  }

  .review figure {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: clamp(24px, 3vw, 44px);
  }

  .review :global(.review__mark) {
    color: var(--accent);
  }

  .review__text {
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--fg);
    max-width: 52ch;
  }

  .review--wide .review__text {
    font-size: clamp(22px, 2.4vw, 34px);
    line-height: 1.3;
    letter-spacing: -0.03em;
    max-width: 38ch;
  }

  .review__author {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .review__ava {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--fg);
    border: 1px solid var(--line-3);
    background: repeating-conic-gradient(rgb(255 255 255 / 0.05) 0 25%, transparent 0 50%) 0 0 / 4px 4px;
  }

  .review__author > span:last-child {
    display: grid;
    gap: 4px;
  }

  .review__name {
    font-size: 15px;
  }

  .review__role {
    font-size: 11px;
    color: var(--fg-3);
  }

  @media (max-width: 760px) {
    .reviews__grid {
      grid-template-columns: 1fr;
    }

    .review--wide figure {
      display: flex;
    }

    .review--wide .review__author {
      align-self: flex-start;
    }
  }
</style>
