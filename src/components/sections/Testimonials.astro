---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { testimonials } from '../../content/site';

const [featured, ...rest] = testimonials.items;
const regular = rest.slice(0, rest.length - 1);
const last = rest[rest.length - 1];
const initials = (name: string) =>
  name
    .split(' ')
    .map((p) => p[0])
    .join('')
    .slice(0, 2);
const gradients = [
  'linear-gradient(135deg,#a798ff,#6c5cf5)',
  'linear-gradient(135deg,#f5b971,#e0795b)',
  'linear-gradient(135deg,#5ee6c8,#2f9f8d)',
  'linear-gradient(135deg,#7fe3f2,#3f8fd8)',
  'linear-gradient(135deg,#f5b0d9,#b05fd0)',
  'linear-gradient(135deg,#c9f27f,#5fb34a)',
];
---

<section class="section testimonials" id="testimonials" aria-labelledby="testimonials-title">
  <div class="container">
    <SectionHeader
      index="06"
      eyebrow={testimonials.eyebrow}
      title={testimonials.title}
      lead={testimonials.lead}
      layout="split"
      headingId="testimonials-title"
    />

    <div class="quotes" data-reveal-stagger>
      <figure class="card quote quote--featured" data-spotlight>
        <span class="spotlight-fill" aria-hidden="true"></span>
        <svg class="quote-mark" viewBox="0 0 48 36" aria-hidden="true">
          <path
            d="M0 36V22.4C0 9.6 6.4 2.13 19.2 0l2.4 5.33C15.47 7.2 12.27 11.2 12 17.33h8.8V36H0Zm27.2 0V22.4C27.2 9.6 33.6 2.13 46.4 0L48 5.33c-6.13 1.87-9.33 5.87-9.6 12h8.8V36H27.2Z"
          ></path>
        </svg>
        <blockquote>
          <p>{featured.quote}</p>
        </blockquote>
        <figcaption class="quote-author">
          <span class="quote-avatar" style={`background:${gradients[0]}`}>{initials(featured.name)}</span>
          <span>
            <strong>{featured.name}</strong>
            <span>{featured.role}, {featured.company}</span>
          </span>
        </figcaption>
      </figure>

      {
        regular.map((t, i) => (
          <figure class="card quote" data-spotlight>
            <span class="spotlight-fill" aria-hidden="true" />
            <div class="quote-stars" role="img" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }, () => (
                <Icon name="star" size={13} />
              ))}
            </div>
            <blockquote>
              <p>{t.quote}</p>
            </blockquote>
            <figcaption class="quote-author">
              <span class="quote-avatar" style={`background:${gradients[(i + 1) % gradients.length]}`}>
                {initials(t.name)}
              </span>
              <span>
                <strong>{t.name}</strong>
                <span>
                  {t.role}, {t.company}
                </span>
              </span>
            </figcaption>
          </figure>
        ))
      }

      <div class="card rating" data-spotlight>
        <span class="spotlight-fill" aria-hidden="true"></span>
        <div class="rating-score">
          <span class="rating-num">{testimonials.rating.score}</span>
          <div>
            <div class="quote-stars quote-stars--lg" role="img" aria-label={`${testimonials.rating.score} out of 5`}>
              {Array.from({ length: 5 }, () => <Icon name="star" size={18} />)}
            </div>
            <p class="rating-label">{testimonials.rating.label}</p>
          </div>
        </div>
        <p class="rating-count">{testimonials.rating.count}</p>
      </div>

      {
        last && (
          <figure class="card quote" data-spotlight>
            <span class="spotlight-fill" aria-hidden="true" />
            <div class="quote-stars" role="img" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }, () => (
                <Icon name="star" size={13} />
              ))}
            </div>
            <blockquote>
              <p>{last.quote}</p>
            </blockquote>
            <figcaption class="quote-author">
              <span class="quote-avatar" style={`background:${gradients[5]}`}>
                {initials(last.name)}
              </span>
              <span>
                <strong>{last.name}</strong>
                <span>
                  {last.role}, {last.company}
                </span>
              </span>
            </figcaption>
          </figure>
        )
      }
    </div>
  </div>
</section>

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    margin: 0;
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
  }

  .quote--featured {
    grid-column: span 2;
    justify-content: space-between;
    background:
      radial-gradient(70% 90% at 0% 0%, rgb(var(--accent-rgb) / 0.12), transparent 60%),
      linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.012)),
      var(--surface);
  }

  .quote--featured blockquote p {
    font-family: var(--font-serif-stack);
    font-size: clamp(1.5rem, 1.15rem + 1.2vw, 2.2rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .quote-mark {
    width: 40px;
    height: 30px;
    fill: var(--accent);
    opacity: 0.9;
  }

  .quote-stars {
    display: flex;
    gap: 2px;
    color: #ffd27a;
  }

  .quote-author {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: auto;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .quote-author > span:last-child {
    display: grid;
  }

  .quote-author strong {
    font-weight: 540;
  }

  .quote-author > span:last-child > span {
    color: var(--text-3);
  }

  .quote-avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: #0b0b12;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.04);
  }

  .rating {
    grid-column: span 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding: clamp(1.4rem, 1.1rem + 1vw, 2rem);
  }

  .rating-score {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .rating-num {
    font-size: clamp(3.5rem, 2.5rem + 3vw, 5rem);
    font-weight: 540;
    letter-spacing: -0.06em;
    line-height: 0.9;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .quote-stars--lg {
    gap: 3px;
    margin-bottom: 0.4rem;
  }

  .rating-label {
    font-size: 0.9rem;
    color: var(--text-2);
  }

  .rating-count {
    max-width: 18rem;
    font-size: 0.85rem;
    color: var(--text-3);
  }

  @media (max-width: 1000px) {
    .quotes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rating {
      grid-column: auto;
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 680px) {
    .quotes {
      grid-template-columns: 1fr;
    }

    .quote--featured,
    .rating {
      grid-column: auto;
    }
  }
</style>
