---
import SectionIntro from '../ui/SectionIntro.astro';
import type { Dictionary } from '@/i18n';

interface Props {
  dict: Dictionary;
  index: number;
}

const { dict, index } = Astro.props;
const s = dict.stack;
const keyWidth = Math.max(...s.groups.map((g) => g.name.length)) + 1;
---

<section class="section stack" id="stack" aria-labelledby="stack-title">
  <div class="container stack__grid">
    <SectionIntro index={index} label={s.label} title={s.title} lead={s.lead} id="stack-title" class="stack__intro" />

    <div class="term corners" data-terminal>
      <span class="corner corner--tl"></span><span class="corner corner--tr"></span>
      <span class="corner corner--bl"></span><span class="corner corner--br"></span>
      <div class="term__bar t-mono">
        <span class="term__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>stack.yml — zsh</span>
        <span class="term__size">120×32</span>
      </div>
      <div class="term__body" style={`--key:${keyWidth}ch`}>
        <p class="term__line">
          <span class="term__prompt">{s.prompt}</span>
          <span class="term__cmd" data-term-cmd>{s.command}</span>
        </p>
        <dl class="term__out">
          {
            s.groups.map((g) => (
              <div class="term__row" data-term-line>
                <dt class="term__key">{g.name}:</dt>
                <dd class="term__vals">
                  <span class="term__punct" aria-hidden="true">[</span>{g.items.map((item, i) => (<><span class="term__item">{item}</span>{i < g.items.length - 1 && <span class="term__punct" aria-hidden="true">, </span>}</>))}<span class="term__punct" aria-hidden="true">]</span>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="term__line" data-term-line>
          <span class="term__prompt">{s.prompt}</span>
          <span class="term__cursor" aria-hidden="true"></span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .stack__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 48px;
    align-items: start;
  }

  .stack__grid :global(.stack__intro) {
    grid-column: 1 / span 5;
  }

  .term {
    grid-column: 6 / span 7;
    background: #0b0b0e;
    border: 1px solid var(--line-2);
    font-family: var(--font-mono);
  }

  .term__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    font-size: 11px;
    color: var(--fg-3);
    border-bottom: 1px solid var(--line);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .term__dots {
    display: flex;
    gap: 6px;
  }

  .term__dots i {
    width: 8px;
    height: 8px;
    background: var(--fg-4);
  }

  .term__dots i:first-child {
    background: var(--accent);
  }

  .term__body {
    padding: clamp(20px, 2.6vw, 32px);
    font-size: clamp(12px, 1.05vw, 14px);
    line-height: 1.9;
    color: var(--fg-2);
    overflow-x: auto;
  }

  .term__line {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .term__prompt {
    color: var(--accent);
    white-space: nowrap;
  }

  .term__cmd {
    color: var(--fg);
  }

  .term__out {
    margin: 10px 0 14px;
  }

  .term__row {
    display: grid;
    grid-template-columns: var(--key) 1fr;
    column-gap: 12px;
  }

  .term__key {
    color: var(--fg);
  }

  .term__vals {
    color: var(--fg-2);
  }

  .term__punct {
    color: var(--fg-4);
  }

  .term__item {
    padding: 1px 2px;
    transition:
      background-color 0.2s steps(2),
      color 0.2s steps(2);
  }

  .term__item:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .term__cursor {
    width: 0.62em;
    height: 1.15em;
    background: var(--fg);
    animation: cursor 1.1s steps(1) infinite;
  }

  @keyframes cursor {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 960px) {
    .stack__grid :global(.stack__intro),
    .term {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .term__row {
      grid-template-columns: 1fr;
    }

    .term__size {
      display: none;
    }
  }
</style>
