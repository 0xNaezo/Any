---
import Ghost from '@/components/ui/Ghost.astro';
import { site } from '@/data/site';

const lines = [
  'mounting /team ............ 4 engineers',
  'loading /work ............. 63 projects',
  'checking capacity ......... ' + site.availability.status,
  'warming up coffee ......... ok',
];
const COLS = 12;
const ROWS = 8;
---

<div class="boot" data-boot aria-hidden="true">
  <div class="boot__tiles" style={`--cols:${COLS};--rows:${ROWS}`}>
    {Array.from({ length: COLS * ROWS }, () => <span class="boot__tile" />)}
  </div>
  <div class="boot__center" data-boot-center>
    <Ghost size={90} fill="dither" class="boot__ghost" />
    <p class="boot__name px">{site.brand.name}</p>
    <div class="boot__bar" data-boot-bar>
      {Array.from({ length: 24 }, () => <span />)}
    </div>
    <p class="boot__pct px" data-boot-pct>000%</p>
  </div>
  <ul class="boot__log tiny" data-boot-log>
    {lines.map((l) => <li><span class="boot__ok">[ ok ]</span> {l}</li>)}
  </ul>
</div>


<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  :global(.no-boot) .boot,
  :global(html:not(.js)) .boot {
    display: none;
  }
  .boot__tiles {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-template-rows: repeat(var(--rows), 1fr);
  }
  .boot__tile {
    background: var(--bg);
    margin: -0.5px;
  }
  .boot__center {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 20px;
    color: var(--accent);
  }
  .boot__name {
    font-size: 32px;
    letter-spacing: 0.12em;
  }
  .boot__bar {
    display: grid;
    grid-template-columns: repeat(24, 8px);
    gap: 2px;
    padding: 4px;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .boot__bar span {
    height: 12px;
    background: var(--accent);
    opacity: 0.12;
  }
  .boot__bar span:global(.on) {
    opacity: 1;
  }
  .boot__pct {
    font-size: 16px;
    color: var(--ink-3);
  }
  .boot__log {
    position: absolute;
    left: var(--gutter);
    bottom: 24px;
    color: var(--ink-3);
    display: grid;
    gap: 2px;
  }
  .boot__log li {
    opacity: 0;
    white-space: pre;
  }
  .boot__ok {
    color: var(--signal);
  }
  @media (max-width: 599px) {
    .boot__log {
      display: none;
    }
  }
</style>
