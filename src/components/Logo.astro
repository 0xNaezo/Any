---
import { GHOST_PATH, GHOST_VIEWBOX } from '../lib/ghost';

interface Props {
  size?: number;
  class?: string;
  /** Show the "Nightloom" wordmark next to the ghost. */
  wordmark?: boolean;
}
const { size = 22, class: className, wordmark = true } = Astro.props;
const [, , w, h] = GHOST_VIEWBOX.split(' ').map(Number);
---

<span class:list={['logo', className]}>
  <svg class="logo__ghost" viewBox={GHOST_VIEWBOX} width={size} height={Math.round((size * h) / w)} aria-hidden="true" focusable="false">
    <path fill="currentColor" fill-rule="evenodd" d={GHOST_PATH}></path>
  </svg>
  {wordmark && <span class="logo__word">Nightloom</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--bone);
  }
  .logo__ghost {
    flex: none;
    transition: transform 0.8s var(--ease-out);
  }
  .logo__word {
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1;
    transform: translateY(-0.04em);
  }
  :global(a:hover) > .logo .logo__ghost {
    transform: translateY(-2px) rotate(-4deg);
  }
</style>
